#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="4.0.0"
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly DOTFILES_DIR
readonly PACKAGES_DIR="${DOTFILES_DIR}/packages"
readonly BREWFILE="${PACKAGES_DIR}/Brewfile"

# The single stow package; its tree mirrors $HOME.
readonly STOW_PACKAGE="home"

# Node toolchain. Must stay in step with PNPM_HOME in home/.config/zsh/.zshenv.
readonly PNPM_HOME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
readonly NODE_VERSION="24"

# Globally installed CLIs, as "package:command" -- the command a package
# provides often differs from its name (@kitlangton/stack -> stack), and
# `dot doctor` needs the command to check the install. Assigned then marked
# readonly separately so this still parses under bash 3.2 on stock macOS.
PNPM_GLOBALS=(
    "opensrc:opensrc"
    "@kitlangton/stack:stack"
    "effect-solutions:effect-solutions"
)
readonly PNPM_GLOBALS

# --- Output helpers ---

info() { printf '\033[0;34m[info]\033[0m %s\n' "$1"; }
ok()   { printf '\033[0;32m[ok]\033[0m %s\n' "$1"; }
warn() { printf '\033[0;33m[warn]\033[0m %s\n' "$1"; }
err()  { printf '\033[0;31m[error]\033[0m %s\n' "$1" >&2; }

command_exists() { command -v "$1" &>/dev/null; }
step() { printf '\033[0;34m[%d/%d]\033[0m %s\n' "$1" "$2" "$3"; }

confirm() {
    local prompt="${1:-Continue?}" default="${2:-n}"
    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n]: "
    else
        prompt="$prompt [y/N]: "
    fi
    read -r -p "$prompt" response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        "") [[ "$default" == "y" ]] && return 0 || return 1 ;;
        *) return 1 ;;
    esac
}

# --- Platform detection ---

detect_platform() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        echo "macos"
    else
        echo "linux"
    fi
}
PLATFORM="$(detect_platform)"
readonly PLATFORM

install_hint() { echo "brew install $1"; }

# Top-level paths under $HOME that the stow package manages. Used to scope
# orphan-symlink scans to subtrees stow actually touches -- we never walk
# unrelated $HOME content (e.g. macOS Documents/Downloads which trigger TCC
# permission prompts on first access).
stow_target_paths() {
    local pkg_dir="${DOTFILES_DIR}/${STOW_PACKAGE}" entry rel
    [[ -d "$pkg_dir" ]] || return 0
    while IFS= read -r -d '' entry; do
        rel="${entry##*/}"
        [[ "$rel" == ".stow-local-ignore" ]] && continue
        printf '%s\0' "${HOME}/${rel}"
    done < <(find "$pkg_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

# Emit NUL-separated paths to broken stow symlinks (orphans left behind
# when a file is deleted from a stow package -- GNU Stow can't clean them
# up because it only walks files that still exist in the package).
#
# Scoped to subtrees the stow package manages; on macOS this avoids
# TCC prompts for unrelated $HOME paths. Both absolute and stow's relative
# symlink targets contain "/<dotfiles-basename>/" (e.g. "/.dotfiles/"), so
# we use that as the lname pattern to filter at the find level (no per-link
# readlink fork).
find_broken_stow_links() {
    local marker pattern
    marker="/$(basename "$DOTFILES_DIR")/"
    pattern="*${marker}*"
    while IFS= read -r -d '' target; do
        if [[ -L "$target" ]]; then
            # Top-level symlink (e.g. $HOME/.zshenv). Confirm it points
            # into our dotfiles before pruning -- never touch a user's
            # own broken symlinks.
            if [[ ! -e "$target" ]]; then
                local link_target
                link_target=$(readlink "$target" 2>/dev/null || true)
                [[ "$link_target" == *"$marker"* ]] && printf '%s\0' "$target"
            fi
        elif [[ -d "$target" ]]; then
            while IFS= read -r -d '' link; do
                [[ -e "$link" ]] || printf '%s\0' "$link"
            done < <(find "$target" -type l -lname "$pattern" -print0 2>/dev/null)
        fi
    done < <(stow_target_paths)
}

# Deep scan across $HOME for any broken symlink into the dotfiles dir.
# Used by `dot doctor` for an explicit thorough audit. On macOS this can
# trigger TCC prompts the first time -- by design, since the user opted
# into a deep check.
find_broken_stow_links_deep() {
    local pattern
    pattern="*/$(basename "$DOTFILES_DIR")/*"
    while IFS= read -r -d '' link; do
        [[ -e "$link" ]] || printf '%s\0' "$link"
    done < <(find "$HOME" -maxdepth 8 -type l -lname "$pattern" -print0 2>/dev/null)
}

prune_broken_stow_links() {
    local pruned=0
    while IFS= read -r -d '' link; do
        rm -f "$link"
        ((++pruned))
        # Collapse parent dirs that became empty after the link was removed.
        local parent
        parent="$(dirname "$link")"
        while [[ "$parent" != "$HOME" && "$parent" != "/" ]]; do
            rmdir "$parent" 2>/dev/null || break
            parent="$(dirname "$parent")"
        done
    done < <(find_broken_stow_links)
    if [[ $pruned -gt 0 ]]; then
        ok "Pruned $pruned orphaned symlink(s)"
    fi
}

# --- Agent hooks ---

# Shared by Claude Code and Codex: both point their hook configs at the same
# ~/.agents/hooks binaries, so unlike skills this needs no per-agent fan-out.
hooks_src_dir() { printf '%s\n' "${DOTFILES_DIR}/${STOW_PACKAGE}/.agents/hooks"; }

# The Go hook binaries are per-machine, per-platform and therefore gitignored,
# so `git pull` never refreshes them -- without this, stow relinks the previous
# build and the hooks keep running stale code after a source change. The
# Makefile's per-binary rules make this a no-op when nothing changed.
build_hooks() {
    local src
    src="$(hooks_src_dir)"
    [[ -f "$src/Makefile" ]] || return 0

    local missing=()
    command_exists make || missing+=("make")
    command_exists go || missing+=("go")
    if [[ ${#missing[@]} -gt 0 ]]; then
        warn "Skipping hook build -- ${missing[*]} not installed ($(install_hint "${missing[0]}"))"
        warn "  Existing hook binaries (if any) are left in place"
        return 0
    fi

    info "Building agent hooks..."
    if make -C "$src"; then
        ok "Hooks built"
    else
        warn "Hook build failed -- previously built binaries are left in place"
        warn "  Re-run manually to see why: make -C $src"
    fi
}

# --- Skills (multi-agent fan-out, flattened category support) ---

# Skills are the one artifact Claude Code and Codex share verbatim, but each
# discovers them under its own root and neither reads the other's. The canonical
# tree lives at Codex's root inside the stow package, but is stow-ignored (see
# home/.stow-local-ignore) because stow can express none of what publishing it
# requires: the one-to-many fan-out, the category flattening below, or the
# folder-level symlink Codex needs (see link_skill_tree). These helpers publish
# it to every destination instead.
#
# Both CLIs only read <root>/<name>/SKILL.md (depth 1), so the source may
# group skills under an optional one-level category dir for human clarity
# (e.g. skills/meta/claude-code-docs/); that layer is flattened away here.

skills_src_dir() { printf '%s\n' "${DOTFILES_DIR}/${STOW_PACKAGE}/.agents/skills"; }

# Where each agent CLI discovers user-scope skills, as "<dir>|<excluded-subdir>".
# Codex reads ~/.agents/skills (its ~/.codex tree holds Codex-specific config
# only). The per-skill agents/ dir carries Codex-only metadata (openai.yaml)
# that Claude Code has no use for, so it's excluded from the Claude side
# rather than left as clutter in ~/.claude/skills.
skill_destinations() {
    printf '%s|%s\n' "${HOME}/.claude/skills" "agents"
    printf '%s|%s\n' "${HOME}/.agents/skills" ""
}

# True when $1 is safe for link_skill_tree to replace: absent, a symlink, or
# a dir we built ourselves (every file under it is a symlink into the dotfiles
# dir). Guards against blowing away a hand-installed skill that happens to
# share a name with one of ours.
skill_dst_is_ours() {
    local path="$1"
    [[ -e "$path" || -L "$path" ]] || return 0
    [[ -L "$path" ]] && return 0
    [[ -d "$path" ]] || return 1
    local marker entry
    marker="/$(basename "$DOTFILES_DIR")/"
    while IFS= read -r -d '' entry; do
        [[ -L "$entry" ]] || return 1
        [[ "$(readlink "$entry")" == *"$marker"* ]] || return 1
    done < <(find "$path" -mindepth 1 ! -type d -print0 2>/dev/null)
    return 0
}

# Returns: flat | category | invalid
skill_dir_kind() {
    local dir="$1"
    if [[ -f "$dir/SKILL.md" ]]; then
        printf 'flat\n'
        return
    fi
    local has_any=0 entry
    while IFS= read -r -d '' entry; do
        local base="${entry##*/}"
        case "$base" in .*|README*|LICENSE*) continue ;; esac
        if [[ -d "$entry" && -f "$entry/SKILL.md" ]]; then
            has_any=1
        else
            printf 'invalid\n'
            return
        fi
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
    if [[ $has_any -eq 1 ]]; then
        printf 'category\n'
    else
        printf 'invalid\n'
    fi
}

# Delete *broken* symlinks under every skill destination that point into the
# dotfiles dir (orphans from removed sources), then rmdir empty parents.
# Links to still-existing sources are left alone -- link_skill_tree() replaces
# those itself if the target needs to change (e.g. a skill moved categories).
prune_skill_links() {
    local marker pattern removed=0 entry dst link
    marker="/$(basename "$DOTFILES_DIR")/"
    pattern="*${marker}*"
    while IFS= read -r entry; do
        dst="${entry%%|*}"
        [[ -d "$dst" ]] || continue
        while IFS= read -r -d '' link; do
            [[ -e "$link" ]] && continue
            rm -f "$link"
            ((++removed))
        done < <(find "$dst" -type l -lname "$pattern" -print0 2>/dev/null)
        find "$dst" -mindepth 1 -depth -type d -empty -delete 2>/dev/null || true
    done < <(skill_destinations)
    if [[ $removed -gt 0 ]]; then
        info "Pruned $removed orphaned skill symlink(s)"
    fi
}

# Publish $src_skill at $dst_skill.
#
# With no $exclude the whole skill dir is symlinked, so source edits and new
# files show up without re-stowing. This is also the only form Codex accepts:
# it follows a symlinked skill *folder*, but ignores a real folder holding a
# symlinked SKILL.md.
#
# $exclude names a top-level subdir to hold back from this destination, which
# rules out a single link -- that tree is reproduced with real dirs and
# per-file symlinks instead (mimics `stow --no-folding`).
link_skill_tree() {
    local src_skill="$1" dst_skill="$2" exclude="${3:-}"
    if ! skill_dst_is_ours "$dst_skill"; then
        err "Refusing to replace $dst_skill -- it holds files not linked from $DOTFILES_DIR"
        err "  Move or delete it, or rename the skill in $(skills_src_dir), then re-run"
        return 1
    fi
    if [[ -z "$exclude" ]]; then
        rm -rf "$dst_skill"
        ln -snf "$src_skill" "$dst_skill"
        return 0
    fi
    [[ -L "$dst_skill" ]] && rm -f "$dst_skill"
    mkdir -p "$dst_skill"
    local file rel target_file
    while IFS= read -r -d '' file; do
        rel="${file#"$src_skill"/}"
        [[ "$rel" == "$exclude"/* ]] && continue
        target_file="${dst_skill}/${rel}"
        mkdir -p "$(dirname "$target_file")"
        ln -snf "$file" "$target_file"
    done < <(find "$src_skill" -type f -print0 2>/dev/null)
}

# Emit "<skill-name>|<source-dir>" for every skill in the canonical tree,
# with the optional category layer flattened away. Fails on duplicate names,
# which would otherwise silently collide in the destination roots.
enumerate_skills() {
    local src seen_names="" entry kind name child child_name
    src="$(skills_src_dir)"
    while IFS= read -r -d '' entry; do
        name="${entry##*/}"
        case "$name" in .git*|README*|LICENSE*) continue ;; esac
        [[ -d "$entry" ]] || continue
        kind="$(skill_dir_kind "$entry")"
        case "$kind" in
            flat)
                case ":$seen_names:" in
                    *":$name:"*)
                        err "Duplicate skill name: $name (at $entry)"
                        return 1
                        ;;
                esac
                seen_names="${seen_names}:${name}"
                printf '%s|%s\n' "$name" "$entry"
                ;;
            category)
                while IFS= read -r -d '' child; do
                    child_name="${child##*/}"
                    case "$child_name" in .*|README*|LICENSE*) continue ;; esac
                    [[ -d "$child" && -f "$child/SKILL.md" ]] || continue
                    case ":$seen_names:" in
                        *":$child_name:"*)
                            err "Duplicate skill name: $child_name (category $name conflicts with earlier)"
                            return 1
                            ;;
                    esac
                    seen_names="${seen_names}:${child_name}"
                    printf '%s|%s\n' "$child_name" "$child"
                done < <(find "$entry" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
                ;;
            invalid)
                err "Skill dir $entry has no SKILL.md and isn't a category of skills"
                return 1
                ;;
        esac
    done < <(find "$src" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

stow_skills() {
    local src listing
    src="$(skills_src_dir)"
    [[ -d "$src" ]] || return 0
    info "Linking agent skills..."
    # Command substitution (not a pipe) so an enumeration failure -- duplicate
    # name, malformed skill dir -- aborts before anything is linked.
    listing="$(enumerate_skills)" || return 1
    prune_skill_links
    local dest_entry dst exclude skill name skill_src count=0
    while IFS= read -r dest_entry; do
        dst="${dest_entry%%|*}"
        exclude="${dest_entry#*|}"
        mkdir -p "$dst"
        count=0
        while IFS= read -r skill; do
            [[ -n "$skill" ]] || continue
            name="${skill%%|*}"
            skill_src="${skill#*|}"
            link_skill_tree "$skill_src" "$dst/$name" "$exclude" || return 1
            ((++count))
        done <<< "$listing"
        ok "Linked $count skill(s) -> $dst"
    done < <(skill_destinations)
}

# --- Core operations ---

install_homebrew() {
    if command_exists brew; then
        ok "Homebrew already installed"
        return 0
    fi

    info "Installing Homebrew..."
    local brew_log
    brew_log=$(mktemp)
    if ! NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" &>"$brew_log"; then
        err "Homebrew installation failed"
        echo "--- Last 20 lines of output ---"
        tail -20 "$brew_log"
        echo "---"
        info "Troubleshooting:"
        info "  - Check disk space: df -h"
        info "  - Check network: curl -fsSL https://github.com"
        info "  - Manual install: https://brew.sh"
        rm -f "$brew_log"
        return 1
    fi
    rm -f "$brew_log"

    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)" || true
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)" || true
    elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" || true
    fi
    ok "Homebrew installed"
}

install_brew_packages() {
    if [[ ! -f "$BREWFILE" ]]; then
        err "Brewfile not found at $BREWFILE"
        return 1
    fi

    info "Installing packages from Brewfile..."
    if brew bundle --file="$BREWFILE"; then
        ok "All packages installed"
        return 0
    fi

    warn "brew bundle failed, installing individually..."
    local failed=()
    local count=0

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            local pkg="${BASH_REMATCH[1]}"
            if brew install "$pkg" 2>/dev/null; then
                ((++count))
            else
                failed+=("brew:$pkg")
            fi
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            local pkg="${BASH_REMATCH[1]}"
            if brew install --cask "$pkg" 2>/dev/null; then
                ((++count))
            else
                failed+=("cask:$pkg")
            fi
        fi
    done < "$BREWFILE"

    if [[ ${#failed[@]} -gt 0 ]]; then
        warn "Failed to install ${#failed[@]} packages:"
        printf "  - %s\n" "${failed[@]}"
        local failed_file
        failed_file="${PACKAGES_DIR}/failed_packages_$(date +%Y%m%d_%H%M%S).txt"
        printf "%s\n" "${failed[@]}" > "$failed_file"
        info "Failures saved to $failed_file"
    fi

    ok "Installed $count packages"
}

# Node toolchain. pnpm is the single source of truth: the standalone
# installer provides pnpm, and `pnpm runtime set` provides node.
# Deliberately not corepack -- upstream advises against installing pnpm
# that way. Keep NODE_VERSION in step with what projects expect.
install_node_toolchain() {
    if ! command_exists pnpm; then
        info "Installing pnpm..."
        local tmp_dir throwaway_zdotdir zsh_path
        tmp_dir="$(mktemp -d)"
        # The installer runs `pnpm setup`, which appends its own PNPM_HOME
        # block to the shell rc it detects. Our tracked .zshenv already
        # carries that block, so point ZDOTDIR at a throwaway directory and
        # discard whatever setup writes there.
        throwaway_zdotdir="$tmp_dir/zdotdir"
        mkdir -p "$throwaway_zdotdir"
        zsh_path="$(command -v zsh || echo /bin/sh)"

        if ! curl -fsSL https://get.pnpm.io/install.sh -o "$tmp_dir/install.sh"; then
            err "Could not download the pnpm installer from get.pnpm.io"
            info "  -> check network, then re-run: dot init"
            rm -rf "$tmp_dir"
            return 1
        fi
        if ! PNPM_HOME="$PNPM_HOME_DIR" ZDOTDIR="$throwaway_zdotdir" SHELL="$zsh_path" \
            sh "$tmp_dir/install.sh"; then
            err "pnpm installer failed"
            info "  -> install manually: https://pnpm.io/installation"
            rm -rf "$tmp_dir"
            return 1
        fi
        rm -rf "$tmp_dir"
        ok "pnpm installed"
    else
        ok "pnpm already installed"
    fi

    # pnpm was just installed into a directory this process doesn't have on
    # PATH yet; the stowed .zshenv handles it for future shells.
    case ":$PATH:" in
        *":$PNPM_HOME_DIR/bin:"*) ;;
        *) export PATH="$PNPM_HOME_DIR/bin:$PATH" ;;
    esac

    info "Setting up Node $NODE_VERSION via pnpm..."
    if ! pnpm runtime set node "$NODE_VERSION" -g; then
        err "pnpm could not install Node $NODE_VERSION"
        info "  -> retry manually: pnpm runtime set node $NODE_VERSION -g"
        return 1
    fi
    ok "Node $(node --version 2>/dev/null || echo "$NODE_VERSION") active"

    local packages=()
    local entry
    for entry in "${PNPM_GLOBALS[@]}"; do
        packages+=("${entry%%:*}")
    done

    info "Installing global packages (${packages[*]})..."
    if ! pnpm add -g "${packages[@]}"; then
        err "Failed to install global packages"
        info "  -> retry manually: pnpm add -g ${packages[*]}"
        return 1
    fi
    ok "Global packages installed"
}

setup_shell() {
    local zsh_path
    zsh_path="$(command -v zsh)"

    if [[ "$SHELL" == "$zsh_path" ]]; then
        ok "zsh is already the default shell"
        return 0
    fi

    info "Setting zsh as default shell..."
    if ! grep -qF "$zsh_path" /etc/shells; then
        echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
    chsh -s "$zsh_path"
    ok "Default shell set to zsh"
}

backup_conflicts() {
    local files_to_backup=() pkg_dir="${DOTFILES_DIR}/${STOW_PACKAGE}"

    while IFS= read -r -d '' file; do
        local rel="${file#"$pkg_dir"/}"
        local target="${HOME}/${rel}"
        if [[ -e "$target" && ! -L "$target" ]]; then
            files_to_backup+=("$rel")
        fi
    done < <(find "$pkg_dir" -type f -print0)

    if [[ ${#files_to_backup[@]} -eq 0 ]]; then
        return 0
    fi

    warn "These existing files would be replaced:"
    printf "  %s\n" "${files_to_backup[@]}"

    if confirm "Back them up first?" "y"; then
        local backup_dir
        backup_dir="${DOTFILES_DIR}/backups/$(date +%Y%m%d_%H%M%S)"
        mkdir -p "$backup_dir"
        for file in "${files_to_backup[@]}"; do
            local src="${HOME}/${file}"
            local dst="${backup_dir}/${file}"
            mkdir -p "$(dirname "$dst")"
            cp -p "$src" "$dst"
        done
        ok "Backups created in $backup_dir"
    fi
}

install_cli_tools() {
    if ! command_exists claude; then
        if confirm "Install Claude Code?" "y"; then
            info "Installing Claude Code..."
            curl -fsSL https://claude.ai/install.sh | bash
        fi
    else
        ok "Claude Code already installed"
    fi

    if ! command_exists bun; then
        if confirm "Install Bun?" "y"; then
            info "Installing Bun..."
            curl -fsSL https://bun.sh/install | bash
        fi
    else
        ok "Bun already installed"
    fi
}

# --- Commands ---

cmd_init() {
    info "Initializing dotfiles (platform: $PLATFORM)"

    local total=7
    step 1 $total "Installing Homebrew"
    install_homebrew
    step 2 $total "Installing packages"
    install_brew_packages
    # Steps 3 and 4 are optional extras -- a network hiccup there must not
    # abort init under `set -e` and leave the dotfiles unstowed.
    step 3 $total "Installing Node toolchain"
    install_node_toolchain || warn "Node toolchain incomplete -- continuing; run 'dot doctor' afterwards"
    step 4 $total "Installing CLI tools"
    install_cli_tools || warn "CLI tool install incomplete -- continuing; run 'dot doctor' afterwards"
    step 5 $total "Backing up conflicts"
    backup_conflicts
    step 6 $total "Stowing dotfiles"
    cmd_stow
    step 7 $total "Setting up shell"
    setup_shell

    echo ""
    ok "Setup complete. Open a new terminal to start using your config."
}

cmd_stow() {
    if ! command_exists stow; then
        err "GNU Stow is not installed ($(install_hint stow))"
        return 1
    fi
    build_hooks
    info "Stowing dotfiles (${STOW_PACKAGE})..."
    prune_broken_stow_links
    stow -R --no-folding --dir="$DOTFILES_DIR" --target="$HOME" "$STOW_PACKAGE"
    stow_skills
    ok "Dotfiles linked"
}

cmd_update() {
    info "Updating dotfiles"

    info "Pulling latest changes..."
    if git -C "$DOTFILES_DIR" pull; then
        ok "Repository updated"
    else
        err "Failed to pull latest changes"
        return 1
    fi

    # Re-exec with the freshly-pulled script so structural changes take effect
    exec "$DOTFILES_DIR/dot" _update-post-pull "$@"
}

cmd_update_post_pull() {
    if confirm "Update Homebrew packages?" "y"; then
        info "Updating Homebrew..."
        brew update && brew upgrade
        ok "Packages updated"
    fi

    cmd_stow
}

cmd_doctor() {
    info "Running diagnostics (platform: $PLATFORM)"
    local issues=0

    # Package manager
    if command_exists brew; then
        ok "Homebrew installed"
    else
        warn "Homebrew not found"
        info "  -> dot init"
        ((++issues))
    fi

    # Core tools
    local tools=(stow zsh git tmux)
    for tool in "${tools[@]}"; do
        if command_exists "$tool"; then
            ok "$tool installed"
        else
            warn "$tool not found"
            info "  -> $(install_hint "$tool")"
            ((++issues))
        fi
    done

    # Node toolchain -- pnpm owns node, so anything resolving elsewhere
    # (a leftover nvm, brew or corepack install) means two node versions are
    # fighting over PATH.
    if command_exists pnpm; then
        ok "pnpm installed ($(pnpm --version))"
    else
        warn "pnpm not found"
        info "  -> dot init"
        ((++issues))
    fi

    if command_exists node; then
        local node_path
        node_path="$(command -v node)"
        if [[ "$node_path" == "$PNPM_HOME_DIR"/* ]]; then
            ok "node $(node --version) (pnpm-managed)"
        else
            warn "node $(node --version) resolves outside pnpm: $node_path"
            info "  -> pnpm runtime set node $NODE_VERSION -g, then remove the other install"
            ((++issues))
        fi
    else
        warn "node not found"
        info "  -> pnpm runtime set node $NODE_VERSION -g"
        ((++issues))
    fi

    local stale_managers=("$HOME/.nvm" "$HOME/.npm-packages")
    for stale in "${stale_managers[@]}"; do
        if [[ -d "$stale" ]]; then
            warn "Stale node manager still on disk: $stale"
            info "  -> pnpm manages node now; remove it: rm -rf $stale"
            ((++issues))
        fi
    done

    local entry pkg cmd cmd_path
    for entry in "${PNPM_GLOBALS[@]}"; do
        pkg="${entry%%:*}"
        cmd="${entry##*:}"
        if ! command_exists "$cmd"; then
            warn "$cmd ($pkg) not found"
            info "  -> pnpm add -g $pkg"
            ((++issues))
            continue
        fi
        cmd_path="$(command -v "$cmd")"
        if [[ "$cmd_path" == "$PNPM_HOME_DIR"/* ]]; then
            ok "$cmd installed"
        else
            warn "$cmd resolves outside pnpm: $cmd_path"
            info "  -> pnpm add -g $pkg, then remove the copy at $cmd_path"
            ((++issues))
        fi
    done

    # Default shell
    if [[ "$SHELL" == *"zsh"* ]]; then
        ok "zsh is default shell"
    else
        warn "zsh is not default shell (currently $SHELL)"
        info "  -> chsh -s \$(command -v zsh)"
        ((++issues))
    fi

    # Broken stow symlinks (deep scan across $HOME for a thorough audit;
    # `dot stow` itself uses a faster scoped scan).
    local broken_list=()
    while IFS= read -r -d '' link; do
        broken_list+=("$link")
    done < <(find_broken_stow_links_deep)

    if [[ ${#broken_list[@]} -eq 0 ]]; then
        ok "No broken stow symlinks"
    else
        warn "Found ${#broken_list[@]} broken stow symlinks:"
        printf "  %s\n" "${broken_list[@]}"
        info "  -> dot stow"
        ((++issues))
    fi

    # SSH key
    if [[ -f "$HOME/.ssh/id_ed25519.pub" || -f "$HOME/.ssh/id_rsa.pub" ]]; then
        ok "SSH key exists"
    else
        warn "No SSH key found"
        info "  -> dot gen-ssh-key"
    fi

    # dot command available
    if command_exists dot; then
        ok "dot command available"
    else
        warn "dot not in PATH -- run 'dot link' to fix"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        ok "All checks passed"
    else
        warn "Found $issues issue(s)"
    fi
}

cmd_package() {
    local subcmd="${1:-list}"
    shift || true

    case "$subcmd" in
        add)    cmd_package_add "$@" ;;
        remove) cmd_package_remove "$@" ;;
        list)   cmd_package_list ;;
        -h|--help|help) cmd_package_help ;;
        *)
            err "Unknown package subcommand: $subcmd"
            cmd_package_help
            return 1
            ;;
    esac
}

cmd_package_add() {
    local name="${1:-}" type="${2:-auto}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package add <name> [brew|cask]"
        return 1
    fi

    # Auto-detect type
    if [[ "$type" == "auto" ]]; then
        if brew info --json=v2 --formula "$name" &>/dev/null; then
            type="brew"
        elif brew info --json=v2 --cask "$name" &>/dev/null; then
            type="cask"
        else
            warn "Package '$name' not found, defaulting to brew formula"
            type="brew"
        fi
    fi

    local entry="${type} \"${name}\""

    # Check if already in Brewfile
    if grep -qF "$entry" "$BREWFILE" 2>/dev/null; then
        warn "'$name' already in Brewfile"
        return 0
    fi

    # Install
    info "Installing $name..."
    if [[ "$type" == "cask" ]]; then
        brew install --cask "$name"
    else
        brew install "$name"
    fi

    # Add to Brewfile in sorted position within same type
    local tmp
    tmp=$(mktemp)
    local inserted=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$inserted" == false && "$line" =~ ^${type}[[:space:]]+\"([^\"]+)\" ]]; then
            local existing="${BASH_REMATCH[1]}"
            if [[ "$name" < "$existing" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
        fi
        echo "$line" >> "$tmp"
    done < "$BREWFILE"

    if [[ "$inserted" == false ]]; then
        echo "$entry" >> "$tmp"
    fi

    mv "$tmp" "$BREWFILE"
    ok "Added '$name' ($type) to Brewfile"
}

cmd_package_remove() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package remove <name>"
        return 1
    fi

    local escaped
    # shellcheck disable=SC2016  # the $( is a literal inside the sed character class, not an expansion
    escaped=$(printf '%s' "$name" | sed 's/[.[*^$()+?{|\\]/\\&/g')

    if ! grep -q "^\(brew\|cask\)[[:space:]]*\"${escaped}\"" "$BREWFILE" 2>/dev/null; then
        warn "'$name' not found in Brewfile"
        return 0
    fi

    # Remove from Brewfile
    local tmp
    tmp=$(mktemp)
    grep -v "^\(brew\|cask\)[[:space:]]*\"${escaped}\"" "$BREWFILE" > "$tmp"
    mv "$tmp" "$BREWFILE"
    ok "Removed '$name' from Brewfile"

    if confirm "Also uninstall '$name' from system?" "n"; then
        brew uninstall "$name" 2>/dev/null || brew uninstall --cask "$name" 2>/dev/null || warn "Could not uninstall '$name'"
    fi
}

cmd_package_list() {
    if [[ ! -f "$BREWFILE" ]]; then
        err "Brewfile not found"
        return 1
    fi

    local installed_formulas installed_casks
    installed_formulas=$(brew list --formula 2>/dev/null || true)
    installed_casks=$(brew list --cask 2>/dev/null || true)

    local brew_pkgs=() cask_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            brew_pkgs+=("${BASH_REMATCH[1]}")
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            cask_pkgs+=("${BASH_REMATCH[1]}")
        fi
    done < "$BREWFILE"

    if [[ ${#brew_pkgs[@]} -gt 0 ]]; then
        echo "Formulas (${#brew_pkgs[@]}):"
        for pkg in "${brew_pkgs[@]}"; do
            if echo "$installed_formulas" | grep -q "^${pkg}$"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi

    if [[ ${#cask_pkgs[@]} -gt 0 ]]; then
        echo "Casks (${#cask_pkgs[@]}):"
        for pkg in "${cask_pkgs[@]}"; do
            if echo "$installed_casks" | grep -q "^${pkg}$"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi
}

cmd_package_help() {
    cat <<EOF
dot package - Brewfile management

USAGE: dot package <subcommand> [args]

SUBCOMMANDS:
    add <name> [brew|cask]  Install and add to Brewfile (auto-detects type)
    remove <name>           Remove from Brewfile, optionally uninstall
    list                    Show packages with install status
    help                    This message
EOF
}

cmd_retry_failed() {
    local failed_file
    failed_file=$(find "$PACKAGES_DIR" -name "failed_packages_*.txt" -type f 2>/dev/null | sort -r | head -1)

    if [[ -z "$failed_file" || ! -f "$failed_file" ]]; then
        info "No failed packages to retry"
        return 0
    fi

    info "Retrying from $failed_file..."
    local success=0 total=0

    while IFS= read -r entry; do
        ((++total))
        if [[ "$entry" =~ ^brew:(.+)$ ]]; then
            if brew install "${BASH_REMATCH[1]}" 2>/dev/null; then
                ok "Installed ${BASH_REMATCH[1]}"
                ((++success))
            else
                warn "Still failing: ${BASH_REMATCH[1]}"
            fi
        elif [[ "$entry" =~ ^cask:(.+)$ ]]; then
            if brew install --cask "${BASH_REMATCH[1]}" 2>/dev/null; then
                ok "Installed ${BASH_REMATCH[1]}"
                ((++success))
            else
                warn "Still failing: ${BASH_REMATCH[1]}"
            fi
        fi
    done < "$failed_file"

    info "Retried $total, succeeded $success"
    if [[ $success -eq $total ]]; then
        rm "$failed_file"
        ok "All failures resolved"
    fi
}

cmd_link() {
    local target_dir="${HOME}/.local/bin"
    mkdir -p "$target_dir"

    local link_path="${target_dir}/dot"
    [[ -L "$link_path" ]] && rm "$link_path"

    ln -s "${DOTFILES_DIR}/dot" "$link_path"
    ok "Linked dot -> $link_path"
    info "Ensure $target_dir is in your PATH"
}

cmd_unlink() {
    local paths=("${HOME}/.local/bin/dot" "/usr/local/bin/dot")
    local found=false

    for p in "${paths[@]}"; do
        if [[ -L "$p" ]]; then
            rm "$p"
            ok "Removed $p"
            found=true
        fi
    done

    if [[ "$found" == false ]]; then
        warn "No dot symlink found"
    fi
}

cmd_edit() {
    exec "${EDITOR:-nvim}" "$DOTFILES_DIR"
}

cmd_gen_ssh_key() {
    local email="${1:-}"
    if [[ -z "$email" ]]; then
        email=$(git config user.email 2>/dev/null || true)
    fi
    if [[ -z "$email" ]]; then
        err "No email provided and git user.email not set"
        err "Usage: dot gen-ssh-key [email]"
        return 1
    fi

    local key_path="$HOME/.ssh/id_ed25519"

    if [[ -f "$key_path" ]]; then
        warn "SSH key already exists at $key_path"
        if ! confirm "Overwrite? (old key will be backed up)" "n"; then
            return 0
        fi
        local backup
        backup="${key_path}.bak.$(date +%Y%m%d_%H%M%S)"
        cp "$key_path" "$backup"
        cp "${key_path}.pub" "${backup}.pub" 2>/dev/null || true
        ok "Backed up existing key to $backup"
    fi

    info "Generating ed25519 SSH key for $email..."
    mkdir -p "$HOME/.ssh"
    ssh-keygen -t ed25519 -C "$email" -f "$key_path"

    # Start ssh-agent if not running
    if ! ssh-add -l &>/dev/null; then
        eval "$(ssh-agent -s)" >/dev/null
    fi
    ssh-add "$key_path" 2>/dev/null

    # Copy to clipboard if possible
    local pubkey
    pubkey=$(<"${key_path}.pub")
    if command_exists wl-copy; then
        echo "$pubkey" | wl-copy
        ok "Public key copied to clipboard (wl-copy)"
    elif command_exists xclip; then
        echo "$pubkey" | xclip -selection clipboard
        ok "Public key copied to clipboard (xclip)"
    elif command_exists pbcopy; then
        echo "$pubkey" | pbcopy
        ok "Public key copied to clipboard (pbcopy)"
    else
        info "Public key (copy manually):"
        echo "$pubkey"
    fi

    echo ""
    info "Next steps:"
    info "  GitHub:  https://github.com/settings/ssh/new"
    info "  GitLab:  https://gitlab.com/-/user_settings/ssh_keys"
}

cmd_completions() {
    local func_dir="${DOTFILES_DIR}/${STOW_PACKAGE}/.config/zsh/functions"
    mkdir -p "$func_dir"

    cat > "${func_dir}/_dot" <<'COMP'
#compdef dot

_dot() {
    local -a commands
    commands=(
        'init:Full bootstrap (packages, stow, shell)'
        'stow:Re-stow dotfiles'
        'update:Pull latest, update packages, re-stow'
        'doctor:Check tools, symlinks, shell health'
        'package:Package management (add/remove/list)'
        'retry-failed:Retry failed package installations'
        'link:Symlink dot into PATH'
        'unlink:Remove dot symlink'
        'edit:Open dotfiles in $EDITOR'
        'gen-ssh-key:Generate ed25519 SSH key'
        'completions:Generate zsh completions'
        'help:Show help message'
    )

    local -a global_opts
    global_opts=(
        '--version[Show version]'
        '(-h --help)'{-h,--help}'[Show help]'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'dot command' commands
        _arguments -s $global_opts
        return
    fi

    case "$words[2]" in
        package)
            local -a subcmds
            subcmds=(
                'add:Install and add to package list'
                'remove:Remove from package list'
                'list:Show packages with install status'
                'help:Show package help'
            )
            if (( CURRENT == 3 )); then
                _describe -t subcmds 'package subcommand' subcmds
            fi
            ;;
    esac
}

_dot "$@"
COMP

    ok "Generated completions at ${func_dir}/_dot"
    info "Run 'dot stow' then open a new shell to activate"
}

cmd_help() {
    cat <<EOF
dot v${VERSION} - dotfiles management (platform: $PLATFORM)

USAGE: dot [command] [args]

COMMANDS:
    init            Full bootstrap (packages, stow, shell)
    stow            Re-stow dotfiles
    update          Pull latest, update packages, re-stow
    doctor          Check tools, symlinks, shell health
    package         Package management (add/remove/list)
    retry-failed    Retry failed package installations
    link            Symlink dot into PATH (~/.local/bin)
    unlink          Remove dot symlink
    edit            Open dotfiles in \$EDITOR
    gen-ssh-key     Generate ed25519 SSH key
    completions     Generate zsh completions
    help            This message

OPTIONS:
    --version       Show version
    -h, --help      This message
EOF
}

# --- Main ---

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version) echo "dot v${VERSION}"; exit 0 ;;
            -h|--help) cmd_help; exit 0 ;;
            *) break ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)                cmd_init "$@" ;;
        stow)                cmd_stow "$@" ;;
        update)              cmd_update "$@" ;;
        _update-post-pull)   cmd_update_post_pull "$@" ;;
        doctor)              cmd_doctor "$@" ;;
        package)             cmd_package "$@" ;;
        retry-failed)        cmd_retry_failed "$@" ;;
        link)                cmd_link "$@" ;;
        unlink)              cmd_unlink "$@" ;;
        edit)                cmd_edit "$@" ;;
        gen-ssh-key)         cmd_gen_ssh_key "$@" ;;
        completions)         cmd_completions "$@" ;;
        help)                cmd_help ;;
        *)
            err "Unknown command: $cmd"
            echo "Run 'dot help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
