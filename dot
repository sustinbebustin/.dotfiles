#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="3.0.0"
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly DOTFILES_DIR
readonly PACKAGES_DIR="${DOTFILES_DIR}/packages"
readonly BREWFILE="${PACKAGES_DIR}/Brewfile"
readonly PACFILE="${PACKAGES_DIR}/Pacfile"

# --- Output helpers ---

info() { printf '\033[0;34m[info]\033[0m %s\n' "$1"; }
ok()   { printf '\033[0;32m[ok]\033[0m %s\n' "$1"; }
warn() { printf '\033[0;33m[warn]\033[0m %s\n' "$1"; }
err()  { printf '\033[0;31m[error]\033[0m %s\n' "$1" >&2; }

command_exists() { command -v "$1" &>/dev/null; }
step() { printf '\033[0;34m[%d/%d]\033[0m %s\n' "$1" "$2" "$3"; }

confirm() {
    local prompt="${1:-Continue?}" default="${2:-n}"
    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n]: "
    else
        prompt="$prompt [y/N]: "
    fi
    read -r -p "$prompt" response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        "") [[ "$default" == "y" ]] && return 0 || return 1 ;;
        *) return 1 ;;
    esac
}

# --- Platform detection ---

detect_platform() {
    if [[ -f /etc/os-release ]] && grep -q '^ID=arch' /etc/os-release; then
        echo "arch"
    elif [[ "$(uname -s)" == "Darwin" ]]; then
        echo "macos"
    else
        echo "linux"
    fi
}
readonly PLATFORM="$(detect_platform)"

aur_helper() {
    if command_exists yay; then echo "yay"
    elif command_exists paru; then echo "paru"
    else echo ""
    fi
}

install_hint() {
    case "$PLATFORM" in
        arch)  echo "sudo pacman -S $1" ;;
        *)     echo "brew install $1" ;;
    esac
}

stow_packages() {
    local packages=("home-common")
    case "$PLATFORM" in
        arch)  packages+=("home-arch") ;;
        macos) packages+=("home-macos") ;;
    esac
    printf '%s\n' "${packages[@]}"
}

# Top-level paths under $HOME that the active stow packages manage. Used
# to scope orphan-symlink scans to subtrees stow actually touches -- we
# never walk unrelated $HOME content (e.g. macOS Documents/Downloads which
# trigger TCC permission prompts on first access).
stow_target_paths() {
    local packages=() pkg pkg_dir entry rel target seen=""
    while IFS= read -r pkg; do packages+=("$pkg"); done < <(stow_packages)
    for pkg in "${packages[@]}"; do
        pkg_dir="${DOTFILES_DIR}/${pkg}"
        [[ -d "$pkg_dir" ]] || continue
        while IFS= read -r -d '' entry; do
            rel="${entry##*/}"
            [[ "$rel" == ".stow-local-ignore" ]] && continue
            target="${HOME}/${rel}"
            # Dedupe across packages (e.g. .config exists in multiple).
            case ":$seen:" in
                *":$target:"*) continue ;;
            esac
            seen="${seen}:${target}"
            printf '%s\0' "$target"
        done < <(find "$pkg_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
    done
}

# Emit NUL-separated paths to broken stow symlinks (orphans left behind
# when a file is deleted from a stow package -- GNU Stow can't clean them
# up because it only walks files that still exist in the package).
#
# Scoped to subtrees the active stow packages manage; on macOS this avoids
# TCC prompts for unrelated $HOME paths. Both absolute and stow's relative
# symlink targets contain "/<dotfiles-basename>/" (e.g. "/.dotfiles/"), so
# we use that as the lname pattern to filter at the find level (no per-link
# readlink fork).
find_broken_stow_links() {
    local marker pattern
    marker="/$(basename "$DOTFILES_DIR")/"
    pattern="*${marker}*"
    while IFS= read -r -d '' target; do
        if [[ -L "$target" ]]; then
            # Top-level symlink (e.g. $HOME/.zshenv). Confirm it points
            # into our dotfiles before pruning -- never touch a user's
            # own broken symlinks.
            if [[ ! -e "$target" ]]; then
                local link_target
                link_target=$(readlink "$target" 2>/dev/null || true)
                [[ "$link_target" == *"$marker"* ]] && printf '%s\0' "$target"
            fi
        elif [[ -d "$target" ]]; then
            while IFS= read -r -d '' link; do
                [[ -e "$link" ]] || printf '%s\0' "$link"
            done < <(find "$target" -type l -lname "$pattern" -print0 2>/dev/null)
        fi
    done < <(stow_target_paths)
}

# Deep scan across $HOME for any broken symlink into the dotfiles dir.
# Used by `dot doctor` for an explicit thorough audit. On macOS this can
# trigger TCC prompts the first time -- by design, since the user opted
# into a deep check.
find_broken_stow_links_deep() {
    local pattern
    pattern="*/$(basename "$DOTFILES_DIR")/*"
    while IFS= read -r -d '' link; do
        [[ -e "$link" ]] || printf '%s\0' "$link"
    done < <(find "$HOME" -maxdepth 8 -type l -lname "$pattern" -print0 2>/dev/null)
}

prune_broken_stow_links() {
    local pruned=0
    while IFS= read -r -d '' link; do
        rm -f "$link"
        ((++pruned))
        # Collapse parent dirs that became empty after the link was removed.
        local parent
        parent="$(dirname "$link")"
        while [[ "$parent" != "$HOME" && "$parent" != "/" ]]; do
            rmdir "$parent" 2>/dev/null || break
            parent="$(dirname "$parent")"
        done
    done < <(find_broken_stow_links)
    if [[ $pruned -gt 0 ]]; then
        ok "Pruned $pruned orphaned symlink(s)"
    fi
}

# --- Claude Code hooks ---

hooks_src_dir() { printf '%s\n' "${DOTFILES_DIR}/home-common/.claude/hooks"; }

# The Go hook binaries are per-machine, per-platform and therefore gitignored,
# so `git pull` never refreshes them -- without this, stow relinks the previous
# build and the hooks keep running stale code after a source change. The
# Makefile's per-binary rules make this a no-op when nothing changed.
build_hooks() {
    local src
    src="$(hooks_src_dir)"
    [[ -f "$src/Makefile" ]] || return 0

    local missing=()
    command_exists make || missing+=("make")
    command_exists go || missing+=("go")
    if [[ ${#missing[@]} -gt 0 ]]; then
        warn "Skipping hook build -- ${missing[*]} not installed ($(install_hint "${missing[0]}"))"
        warn "  Existing hook binaries (if any) are left in place"
        return 0
    fi

    info "Building Claude Code hooks..."
    if make -C "$src"; then
        ok "Hooks built"
    else
        warn "Hook build failed -- previously built binaries are left in place"
        warn "  Re-run manually to see why: make -C $src"
    fi
}

# --- Skills (multi-agent fan-out, flattened category support) ---

# Skills are the one artifact Claude Code and Codex share verbatim, but each
# discovers them under its own root and neither reads the other's. So the
# canonical tree lives outside the stow packages (it maps to no single $HOME
# path) and these helpers mirror it into every destination -- stow can't
# express a one-to-many fan-out.
#
# Both CLIs only read <root>/<name>/SKILL.md (depth 1), so the source may
# group skills under an optional one-level category dir for human clarity
# (e.g. skills/meta/claude-code-docs/); that layer is flattened away here.

skills_src_dir() { printf '%s\n' "${DOTFILES_DIR}/skills"; }

# Where each agent CLI discovers user-scope skills, as "<dir>|<excluded-subdir>".
# Codex reads ~/.agents/skills (its ~/.codex tree holds Codex-specific config
# only). The per-skill agents/ dir carries Codex-only metadata (openai.yaml)
# that Claude Code has no use for, so it's excluded from the Claude side
# rather than left as clutter in ~/.claude/skills.
skill_destinations() {
    printf '%s|%s\n' "${HOME}/.claude/skills" "agents"
    printf '%s|%s\n' "${HOME}/.agents/skills" ""
}

# True when $1 is safe for link_skill_tree to replace: absent, a symlink, or
# a dir we built ourselves (every file under it is a symlink into the dotfiles
# dir). Guards against blowing away a hand-installed skill that happens to
# share a name with one of ours.
skill_dst_is_ours() {
    local path="$1"
    [[ -e "$path" || -L "$path" ]] || return 0
    [[ -L "$path" ]] && return 0
    [[ -d "$path" ]] || return 1
    local marker entry
    marker="/$(basename "$DOTFILES_DIR")/"
    while IFS= read -r -d '' entry; do
        [[ -L "$entry" ]] || return 1
        [[ "$(readlink "$entry")" == *"$marker"* ]] || return 1
    done < <(find "$path" -mindepth 1 ! -type d -print0 2>/dev/null)
    return 0
}

# Returns: flat | category | invalid
skill_dir_kind() {
    local dir="$1"
    if [[ -f "$dir/SKILL.md" ]]; then
        printf 'flat\n'
        return
    fi
    local has_any=0 entry
    while IFS= read -r -d '' entry; do
        local base="${entry##*/}"
        case "$base" in .*|README*|LICENSE*) continue ;; esac
        if [[ -d "$entry" && -f "$entry/SKILL.md" ]]; then
            has_any=1
        else
            printf 'invalid\n'
            return
        fi
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
    if [[ $has_any -eq 1 ]]; then
        printf 'category\n'
    else
        printf 'invalid\n'
    fi
}

# Delete *broken* symlinks under every skill destination that point into the
# dotfiles dir (orphans from removed sources), then rmdir empty parents.
# Links to still-existing sources are left alone -- link_skill_tree() replaces
# those itself if the target needs to change (e.g. a skill moved categories).
prune_skill_links() {
    local marker pattern removed=0 entry dst link
    marker="/$(basename "$DOTFILES_DIR")/"
    pattern="*${marker}*"
    while IFS= read -r entry; do
        dst="${entry%%|*}"
        [[ -d "$dst" ]] || continue
        while IFS= read -r -d '' link; do
            [[ -e "$link" ]] && continue
            rm -f "$link"
            ((++removed))
        done < <(find "$dst" -type l -lname "$pattern" -print0 2>/dev/null)
        find "$dst" -mindepth 1 -depth -type d -empty -delete 2>/dev/null || true
    done < <(skill_destinations)
    if [[ $removed -gt 0 ]]; then
        info "Pruned $removed orphaned skill symlink(s)"
    fi
}

# Publish $src_skill at $dst_skill.
#
# With no $exclude the whole skill dir is symlinked, so source edits and new
# files show up without re-stowing. This is also the only form Codex accepts:
# it follows a symlinked skill *folder*, but ignores a real folder holding a
# symlinked SKILL.md.
#
# $exclude names a top-level subdir to hold back from this destination, which
# rules out a single link -- that tree is reproduced with real dirs and
# per-file symlinks instead (mimics `stow --no-folding`).
link_skill_tree() {
    local src_skill="$1" dst_skill="$2" exclude="${3:-}"
    if ! skill_dst_is_ours "$dst_skill"; then
        err "Refusing to replace $dst_skill -- it holds files not linked from $DOTFILES_DIR"
        err "  Move or delete it, or rename the skill in $(skills_src_dir), then re-run"
        return 1
    fi
    if [[ -z "$exclude" ]]; then
        rm -rf "$dst_skill"
        ln -snf "$src_skill" "$dst_skill"
        return 0
    fi
    [[ -L "$dst_skill" ]] && rm -f "$dst_skill"
    mkdir -p "$dst_skill"
    local file rel target_file
    while IFS= read -r -d '' file; do
        rel="${file#"$src_skill"/}"
        [[ "$rel" == "$exclude"/* ]] && continue
        target_file="${dst_skill}/${rel}"
        mkdir -p "$(dirname "$target_file")"
        ln -snf "$file" "$target_file"
    done < <(find "$src_skill" -type f -print0 2>/dev/null)
}

# Emit "<skill-name>|<source-dir>" for every skill in the canonical tree,
# with the optional category layer flattened away. Fails on duplicate names,
# which would otherwise silently collide in the destination roots.
enumerate_skills() {
    local src seen_names="" entry kind name child child_name
    src="$(skills_src_dir)"
    while IFS= read -r -d '' entry; do
        name="${entry##*/}"
        case "$name" in .git*|README*|LICENSE*) continue ;; esac
        [[ -d "$entry" ]] || continue
        kind="$(skill_dir_kind "$entry")"
        case "$kind" in
            flat)
                case ":$seen_names:" in
                    *":$name:"*)
                        err "Duplicate skill name: $name (at $entry)"
                        return 1
                        ;;
                esac
                seen_names="${seen_names}:${name}"
                printf '%s|%s\n' "$name" "$entry"
                ;;
            category)
                while IFS= read -r -d '' child; do
                    child_name="${child##*/}"
                    case "$child_name" in .*|README*|LICENSE*) continue ;; esac
                    [[ -d "$child" && -f "$child/SKILL.md" ]] || continue
                    case ":$seen_names:" in
                        *":$child_name:"*)
                            err "Duplicate skill name: $child_name (category $name conflicts with earlier)"
                            return 1
                            ;;
                    esac
                    seen_names="${seen_names}:${child_name}"
                    printf '%s|%s\n' "$child_name" "$child"
                done < <(find "$entry" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
                ;;
            invalid)
                err "Skill dir $entry has no SKILL.md and isn't a category of skills"
                return 1
                ;;
        esac
    done < <(find "$src" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

stow_skills() {
    local src listing
    src="$(skills_src_dir)"
    [[ -d "$src" ]] || return 0
    info "Linking agent skills..."
    # Command substitution (not a pipe) so an enumeration failure -- duplicate
    # name, malformed skill dir -- aborts before anything is linked.
    listing="$(enumerate_skills)" || return 1
    prune_skill_links
    local dest_entry dst exclude skill name skill_src count=0
    while IFS= read -r dest_entry; do
        dst="${dest_entry%%|*}"
        exclude="${dest_entry#*|}"
        mkdir -p "$dst"
        count=0
        while IFS= read -r skill; do
            [[ -n "$skill" ]] || continue
            name="${skill%%|*}"
            skill_src="${skill#*|}"
            link_skill_tree "$skill_src" "$dst/$name" "$exclude" || return 1
            ((++count))
        done <<< "$listing"
        ok "Linked $count skill(s) -> $dst"
    done < <(skill_destinations)
}

# --- Core operations ---

install_homebrew() {
    if command_exists brew; then
        ok "Homebrew already installed"
        return 0
    fi

    info "Installing Homebrew..."
    local brew_log
    brew_log=$(mktemp)
    if ! NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" &>"$brew_log"; then
        err "Homebrew installation failed"
        echo "--- Last 20 lines of output ---"
        tail -20 "$brew_log"
        echo "---"
        info "Troubleshooting:"
        info "  - Check disk space: df -h"
        info "  - Check network: curl -fsSL https://github.com"
        info "  - Manual install: https://brew.sh"
        rm -f "$brew_log"
        return 1
    fi
    rm -f "$brew_log"

    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)" || true
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)" || true
    elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" || true
    fi
    ok "Homebrew installed"
}

install_brew_packages() {
    if [[ ! -f "$BREWFILE" ]]; then
        err "Brewfile not found at $BREWFILE"
        return 1
    fi

    info "Installing packages from Brewfile..."
    if brew bundle --file="$BREWFILE"; then
        ok "All packages installed"
        return 0
    fi

    warn "brew bundle failed, installing individually..."
    local failed=()
    local count=0

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            local pkg="${BASH_REMATCH[1]}"
            if brew install "$pkg" 2>/dev/null; then
                ((++count))
            else
                failed+=("brew:$pkg")
            fi
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            local pkg="${BASH_REMATCH[1]}"
            if brew install --cask "$pkg" 2>/dev/null; then
                ((++count))
            else
                failed+=("cask:$pkg")
            fi
        fi
    done < "$BREWFILE"

    if [[ ${#failed[@]} -gt 0 ]]; then
        warn "Failed to install ${#failed[@]} packages:"
        printf "  - %s\n" "${failed[@]}"
        local failed_file="${PACKAGES_DIR}/failed_packages_$(date +%Y%m%d_%H%M%S).txt"
        printf "%s\n" "${failed[@]}" > "$failed_file"
        info "Failures saved to $failed_file"
    fi

    ok "Installed $count packages"
}

install_pacman_packages() {
    if [[ ! -f "$PACFILE" ]]; then
        err "Pacfile not found at $PACFILE"
        return 1
    fi

    local pacman_pkgs=() aur_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^\[aur\][[:space:]]+(.+)$ ]]; then
            aur_pkgs+=("${BASH_REMATCH[1]}")
        else
            pacman_pkgs+=("${line#"${line%%[![:space:]]*}"}")
        fi
    done < "$PACFILE"

    local failed=()

    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        info "Installing ${#pacman_pkgs[@]} pacman packages..."
        if ! sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"; then
            warn "Some pacman packages failed to install"
            for pkg in "${pacman_pkgs[@]}"; do
                if ! pacman -Qi "$pkg" &>/dev/null; then
                    failed+=("pacman:$pkg")
                fi
            done
        fi
    fi

    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        local helper
        helper="$(aur_helper)"
        if [[ -z "$helper" ]]; then
            warn "No AUR helper found (yay or paru). Skipping AUR packages:"
            printf "  - %s\n" "${aur_pkgs[@]}"
            for pkg in "${aur_pkgs[@]}"; do
                failed+=("aur:$pkg")
            done
        else
            info "Installing ${#aur_pkgs[@]} AUR packages via $helper..."
            if ! "$helper" -S --needed --noconfirm "${aur_pkgs[@]}"; then
                warn "Some AUR packages failed to install"
                for pkg in "${aur_pkgs[@]}"; do
                    if ! pacman -Qi "$pkg" &>/dev/null; then
                        failed+=("aur:$pkg")
                    fi
                done
            fi
        fi
    fi

    if [[ ${#failed[@]} -gt 0 ]]; then
        warn "Failed to install ${#failed[@]} packages:"
        printf "  - %s\n" "${failed[@]}"
        local failed_file="${PACKAGES_DIR}/failed_packages_$(date +%Y%m%d_%H%M%S).txt"
        printf "%s\n" "${failed[@]}" > "$failed_file"
        info "Failures saved to $failed_file"
    fi

    ok "Package installation complete"
}

install_npm_globals() {
    info "Installing global npm packages..."
    npm install -g opensrc
    ok "Global npm packages installed"
}

setup_shell() {
    local zsh_path
    zsh_path="$(command -v zsh)"

    if [[ "$SHELL" == "$zsh_path" ]]; then
        ok "zsh is already the default shell"
        return 0
    fi

    info "Setting zsh as default shell..."
    if ! grep -qF "$zsh_path" /etc/shells; then
        echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
    chsh -s "$zsh_path"
    ok "Default shell set to zsh"
}

backup_conflicts() {
    local files_to_backup=()
    local packages=()
    while IFS= read -r pkg; do packages+=("$pkg"); done < <(stow_packages)

    for pkg in "${packages[@]}"; do
        while IFS= read -r -d '' file; do
            local rel="${file#"${DOTFILES_DIR}/${pkg}"/}"
            local target="${HOME}/${rel}"
            if [[ -e "$target" && ! -L "$target" ]]; then
                files_to_backup+=("$rel")
            fi
        done < <(find "${DOTFILES_DIR}/${pkg}" -type f -print0)
    done

    if [[ ${#files_to_backup[@]} -eq 0 ]]; then
        return 0
    fi

    warn "These existing files would be replaced:"
    printf "  %s\n" "${files_to_backup[@]}"

    if confirm "Back them up first?" "y"; then
        local backup_dir="${DOTFILES_DIR}/backups/$(date +%Y%m%d_%H%M%S)"
        mkdir -p "$backup_dir"
        for file in "${files_to_backup[@]}"; do
            local src="${HOME}/${file}"
            local dst="${backup_dir}/${file}"
            mkdir -p "$(dirname "$dst")"
            cp -p "$src" "$dst"
        done
        ok "Backups created in $backup_dir"
    fi
}

install_cli_tools() {
    if ! command_exists claude; then
        if confirm "Install Claude Code?" "y"; then
            info "Installing Claude Code..."
            curl -fsSL https://claude.ai/install.sh | bash
        fi
    else
        ok "Claude Code already installed"
    fi

    if ! command_exists opencode; then
        if confirm "Install OpenCode?" "y"; then
            info "Installing OpenCode..."
            curl -fsSL https://opencode.ai/install | bash
        fi
    else
        ok "OpenCode already installed"
    fi
}

# --- Commands ---

cmd_init() {
    info "Initializing dotfiles (platform: $PLATFORM)"

    case "$PLATFORM" in
        arch)
            local total=5
            step 1 $total "Installing packages"
            install_pacman_packages
            step 2 $total "Installing CLI tools"
            install_cli_tools
            step 3 $total "Backing up conflicts"
            backup_conflicts
            step 4 $total "Stowing dotfiles"
            cmd_stow
            step 5 $total "Setting up shell"
            setup_shell
            ;;
        *)
            local total=7
            step 1 $total "Installing Homebrew"
            install_homebrew
            step 2 $total "Installing packages"
            install_brew_packages
            step 3 $total "Installing npm globals"
            install_npm_globals
            step 4 $total "Installing CLI tools"
            install_cli_tools
            step 5 $total "Backing up conflicts"
            backup_conflicts
            step 6 $total "Stowing dotfiles"
            cmd_stow
            step 7 $total "Setting up shell"
            setup_shell
            ;;
    esac

    echo ""
    ok "Setup complete. Open a new terminal to start using your config."
}

cmd_stow() {
    if ! command_exists stow; then
        err "GNU Stow is not installed ($(install_hint stow))"
        return 1
    fi
    local packages=()
    while IFS= read -r pkg; do packages+=("$pkg"); done < <(stow_packages)
    build_hooks
    info "Stowing dotfiles (${packages[*]})..."
    prune_broken_stow_links
    stow -R --no-folding --dir="$DOTFILES_DIR" --target="$HOME" "${packages[@]}"
    stow_skills
    ok "Dotfiles linked"
}

cmd_update() {
    info "Updating dotfiles"

    info "Pulling latest changes..."
    if git -C "$DOTFILES_DIR" pull; then
        ok "Repository updated"
    else
        err "Failed to pull latest changes"
        return 1
    fi

    # Re-exec with the freshly-pulled script so structural changes take effect
    exec "$DOTFILES_DIR/dot" _update-post-pull "$@"
}

cmd_update_post_pull() {
    case "$PLATFORM" in
        arch)
            if confirm "Update system packages?" "y"; then
                info "Updating pacman packages..."
                sudo pacman -Syu
                local helper
                helper="$(aur_helper)"
                if [[ -n "$helper" ]]; then
                    info "Updating AUR packages..."
                    "$helper" -Syu
                fi
                ok "Packages updated"
            fi
            ;;
        *)
            if confirm "Update Homebrew packages?" "y"; then
                info "Updating Homebrew..."
                brew update && brew upgrade
                ok "Packages updated"
            fi
            ;;
    esac

    cmd_stow
}

cmd_doctor() {
    info "Running diagnostics (platform: $PLATFORM)"
    local issues=0

    # Package manager
    case "$PLATFORM" in
        arch)
            if command_exists pacman; then
                ok "pacman available"
            else
                warn "pacman not found"
                ((++issues))
            fi
            local helper
            helper="$(aur_helper)"
            if [[ -n "$helper" ]]; then
                ok "AUR helper: $helper"
            else
                warn "No AUR helper found (yay or paru)"
                info "  -> install yay or paru for AUR support"
                ((++issues))
            fi
            ;;
        *)
            if command_exists brew; then
                ok "Homebrew installed"
            else
                warn "Homebrew not found"
                info "  -> dot init"
                ((++issues))
            fi
            ;;
    esac

    # Core tools
    local tools=(stow zsh git tmux)
    for tool in "${tools[@]}"; do
        if command_exists "$tool"; then
            ok "$tool installed"
        else
            warn "$tool not found"
            info "  -> $(install_hint "$tool")"
            ((++issues))
        fi
    done

    # Default shell
    if [[ "$SHELL" == *"zsh"* ]]; then
        ok "zsh is default shell"
    else
        warn "zsh is not default shell (currently $SHELL)"
        info "  -> chsh -s \$(command -v zsh)"
        ((++issues))
    fi

    # Broken stow symlinks (deep scan across $HOME for a thorough audit;
    # `dot stow` itself uses a faster scoped scan).
    local broken_list=()
    while IFS= read -r -d '' link; do
        broken_list+=("$link")
    done < <(find_broken_stow_links_deep)

    if [[ ${#broken_list[@]} -eq 0 ]]; then
        ok "No broken stow symlinks"
    else
        warn "Found ${#broken_list[@]} broken stow symlinks:"
        printf "  %s\n" "${broken_list[@]}"
        info "  -> dot stow"
        ((++issues))
    fi

    # SSH key
    if [[ -f "$HOME/.ssh/id_ed25519.pub" || -f "$HOME/.ssh/id_rsa.pub" ]]; then
        ok "SSH key exists"
    else
        warn "No SSH key found"
        info "  -> dot gen-ssh-key"
    fi

    # dot command available
    if command_exists dot; then
        ok "dot command available"
    else
        warn "dot not in PATH -- run 'dot link' to fix"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        ok "All checks passed"
    else
        warn "Found $issues issue(s)"
    fi
}

cmd_package() {
    local subcmd="${1:-list}"
    shift || true

    case "$subcmd" in
        add)    cmd_package_add "$@" ;;
        remove) cmd_package_remove "$@" ;;
        list)   cmd_package_list ;;
        -h|--help|help) cmd_package_help ;;
        *)
            err "Unknown package subcommand: $subcmd"
            cmd_package_help
            return 1
            ;;
    esac
}

cmd_package_add() {
    case "$PLATFORM" in
        arch) cmd_package_add_pacman "$@" ;;
        *)    cmd_package_add_brew "$@" ;;
    esac
}

cmd_package_add_brew() {
    local name="${1:-}" type="${2:-auto}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package add <name> [brew|cask]"
        return 1
    fi

    # Auto-detect type
    if [[ "$type" == "auto" ]]; then
        if brew info --json=v2 --formula "$name" &>/dev/null; then
            type="brew"
        elif brew info --json=v2 --cask "$name" &>/dev/null; then
            type="cask"
        else
            warn "Package '$name' not found, defaulting to brew formula"
            type="brew"
        fi
    fi

    local entry="${type} \"${name}\""

    # Check if already in Brewfile
    if grep -qF "$entry" "$BREWFILE" 2>/dev/null; then
        warn "'$name' already in Brewfile"
        return 0
    fi

    # Install
    info "Installing $name..."
    if [[ "$type" == "cask" ]]; then
        brew install --cask "$name"
    else
        brew install "$name"
    fi

    # Add to Brewfile in sorted position within same type
    local tmp
    tmp=$(mktemp)
    local inserted=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$inserted" == false && "$line" =~ ^${type}[[:space:]]+\"([^\"]+)\" ]]; then
            local existing="${BASH_REMATCH[1]}"
            if [[ "$name" < "$existing" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
        fi
        echo "$line" >> "$tmp"
    done < "$BREWFILE"

    if [[ "$inserted" == false ]]; then
        echo "$entry" >> "$tmp"
    fi

    mv "$tmp" "$BREWFILE"
    ok "Added '$name' ($type) to Brewfile"
}

cmd_package_add_pacman() {
    local name="${1:-}" type="${2:-auto}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package add <name> [pacman|aur]"
        return 1
    fi

    # Auto-detect type
    if [[ "$type" == "auto" ]]; then
        if pacman -Si "$name" &>/dev/null; then
            type="pacman"
        else
            local helper
            helper="$(aur_helper)"
            if [[ -n "$helper" ]] && "$helper" -Si "$name" &>/dev/null; then
                type="aur"
            else
                warn "Package '$name' not found in repos or AUR, defaulting to pacman"
                type="pacman"
            fi
        fi
    fi

    local entry
    if [[ "$type" == "aur" ]]; then
        entry="[aur] ${name}"
    else
        entry="$name"
    fi

    # Check if already in Pacfile
    if grep -qxF "$entry" "$PACFILE" 2>/dev/null; then
        warn "'$name' already in Pacfile"
        return 0
    fi

    # Install
    info "Installing $name..."
    if [[ "$type" == "aur" ]]; then
        local helper
        helper="$(aur_helper)"
        if [[ -z "$helper" ]]; then
            err "No AUR helper available to install '$name'"
            return 1
        fi
        "$helper" -S --needed "$name"
    else
        sudo pacman -S --needed "$name"
    fi

    # Insert sorted into Pacfile
    if [[ "$type" == "aur" ]]; then
        # Insert among AUR entries (lines starting with [aur])
        local tmp
        tmp=$(mktemp)
        local inserted=false
        while IFS= read -r line; do
            if [[ "$inserted" == false && "$line" =~ ^\[aur\] ]] && [[ "$entry" < "$line" || "$entry" == "$line" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
            echo "$line" >> "$tmp"
        done < "$PACFILE"
        if [[ "$inserted" == false ]]; then
            echo "$entry" >> "$tmp"
        fi
        mv "$tmp" "$PACFILE"
    else
        # Insert among non-AUR, non-comment, non-empty lines in sorted position
        local tmp
        tmp=$(mktemp)
        local inserted=false
        while IFS= read -r line; do
            if [[ "$inserted" == false ]] && [[ ! "$line" =~ ^[[:space:]]*# ]] && [[ -n "${line// }" ]] && [[ ! "$line" =~ ^\[aur\] ]] && [[ "$entry" < "$line" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
            echo "$line" >> "$tmp"
        done < "$PACFILE"
        if [[ "$inserted" == false ]]; then
            # Insert before the AUR section if it exists
            local aur_line
            aur_line=$(grep -n '^\[aur\]' "$tmp" | head -1 | cut -d: -f1)
            if [[ -n "$aur_line" ]]; then
                sed -i "${aur_line}i\\${entry}" "$tmp"
            else
                echo "$entry" >> "$tmp"
            fi
        fi
        mv "$tmp" "$PACFILE"
    fi
    ok "Added '$name' ($type) to Pacfile"
}

cmd_package_remove() {
    case "$PLATFORM" in
        arch) cmd_package_remove_pacman "$@" ;;
        *)    cmd_package_remove_brew "$@" ;;
    esac
}

cmd_package_remove_brew() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package remove <name>"
        return 1
    fi

    local escaped
    escaped=$(printf '%s' "$name" | sed 's/[.[*^$()+?{|\\]/\\&/g')

    if ! grep -q "^\(brew\|cask\)[[:space:]]*\"${escaped}\"" "$BREWFILE" 2>/dev/null; then
        warn "'$name' not found in Brewfile"
        return 0
    fi

    # Remove from Brewfile
    local tmp
    tmp=$(mktemp)
    grep -v "^\(brew\|cask\)[[:space:]]*\"${escaped}\"" "$BREWFILE" > "$tmp"
    mv "$tmp" "$BREWFILE"
    ok "Removed '$name' from Brewfile"

    if confirm "Also uninstall '$name' from system?" "n"; then
        brew uninstall "$name" 2>/dev/null || brew uninstall --cask "$name" 2>/dev/null || warn "Could not uninstall '$name'"
    fi
}

cmd_package_remove_pacman() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package remove <name>"
        return 1
    fi

    local found=false
    local tmp
    tmp=$(mktemp)

    while IFS= read -r line; do
        if [[ "$line" == "$name" || "$line" == "[aur] $name" ]]; then
            found=true
            continue
        fi
        echo "$line" >> "$tmp"
    done < "$PACFILE"

    if [[ "$found" == false ]]; then
        warn "'$name' not found in Pacfile"
        rm -f "$tmp"
        return 0
    fi

    mv "$tmp" "$PACFILE"
    ok "Removed '$name' from Pacfile"

    if confirm "Also uninstall '$name' from system?" "n"; then
        sudo pacman -R "$name" 2>/dev/null || warn "Could not uninstall '$name'"
    fi
}

cmd_package_list() {
    case "$PLATFORM" in
        arch) cmd_package_list_pacman ;;
        *)    cmd_package_list_brew ;;
    esac
}

cmd_package_list_brew() {
    if [[ ! -f "$BREWFILE" ]]; then
        err "Brewfile not found"
        return 1
    fi

    local installed_formulas installed_casks
    installed_formulas=$(brew list --formula 2>/dev/null || true)
    installed_casks=$(brew list --cask 2>/dev/null || true)

    local brew_pkgs=() cask_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            brew_pkgs+=("${BASH_REMATCH[1]}")
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            cask_pkgs+=("${BASH_REMATCH[1]}")
        fi
    done < "$BREWFILE"

    if [[ ${#brew_pkgs[@]} -gt 0 ]]; then
        echo "Formulas (${#brew_pkgs[@]}):"
        for pkg in "${brew_pkgs[@]}"; do
            if echo "$installed_formulas" | grep -q "^${pkg}$"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi

    if [[ ${#cask_pkgs[@]} -gt 0 ]]; then
        echo "Casks (${#cask_pkgs[@]}):"
        for pkg in "${cask_pkgs[@]}"; do
            if echo "$installed_casks" | grep -q "^${pkg}$"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi
}

cmd_package_list_pacman() {
    if [[ ! -f "$PACFILE" ]]; then
        err "Pacfile not found"
        return 1
    fi

    local installed
    installed=$(pacman -Qq 2>/dev/null || true)

    local pacman_pkgs=() aur_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^\[aur\][[:space:]]+(.+)$ ]]; then
            aur_pkgs+=("${BASH_REMATCH[1]}")
        else
            pacman_pkgs+=("${line#"${line%%[![:space:]]*}"}")
        fi
    done < "$PACFILE"

    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        echo "Pacman (${#pacman_pkgs[@]}):"
        for pkg in "${pacman_pkgs[@]}"; do
            if echo "$installed" | grep -qx "$pkg"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi

    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        echo "AUR (${#aur_pkgs[@]}):"
        for pkg in "${aur_pkgs[@]}"; do
            if echo "$installed" | grep -qx "$pkg"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi
}

cmd_package_help() {
    if [[ "$PLATFORM" == "arch" ]]; then
        cat <<EOF
dot package - Pacfile management

USAGE: dot package <subcommand> [args]

SUBCOMMANDS:
    add <name> [pacman|aur]  Install and add to Pacfile (auto-detects type)
    remove <name>            Remove from Pacfile, optionally uninstall
    list                     Show packages with install status
