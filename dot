#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="3.0.0"
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly DOTFILES_DIR
readonly PACKAGES_DIR="${DOTFILES_DIR}/packages"
readonly BREWFILE="${PACKAGES_DIR}/Brewfile"
readonly PACFILE="${PACKAGES_DIR}/Pacfile"

# --- Output helpers ---

info() { printf '\033[0;34m[info]\033[0m %s\n' "$1"; }
ok()   { printf '\033[0;32m[ok]\033[0m %s\n' "$1"; }
warn() { printf '\033[0;33m[warn]\033[0m %s\n' "$1"; }
err()  { printf '\033[0;31m[error]\033[0m %s\n' "$1" >&2; }

command_exists() { command -v "$1" &>/dev/null; }
step() { printf '\033[0;34m[%d/%d]\033[0m %s\n' "$1" "$2" "$3"; }

confirm() {
    local prompt="${1:-Continue?}" default="${2:-n}"
    if [[ "$default" == "y" ]]; then
        prompt="$prompt [Y/n]: "
    else
        prompt="$prompt [y/N]: "
    fi
    read -r -p "$prompt" response
    case "$response" in
        [yY][eE][sS]|[yY]) return 0 ;;
        "") [[ "$default" == "y" ]] && return 0 || return 1 ;;
        *) return 1 ;;
    esac
}

# --- Platform detection ---

detect_platform() {
    if [[ -f /etc/os-release ]] && grep -q '^ID=arch' /etc/os-release; then
        echo "arch"
    elif [[ "$(uname -s)" == "Darwin" ]]; then
        echo "macos"
    else
        echo "linux"
    fi
}
readonly PLATFORM="$(detect_platform)"

aur_helper() {
    if command_exists yay; then echo "yay"
    elif command_exists paru; then echo "paru"
    else echo ""
    fi
}

install_hint() {
    case "$PLATFORM" in
        arch)  echo "sudo pacman -S $1" ;;
        *)     echo "brew install $1" ;;
    esac
}

stow_packages() {
    local packages=("home-common")
    case "$PLATFORM" in
        arch)  packages+=("home-arch") ;;
        macos) packages+=("home-macos") ;;
    esac
    printf '%s\n' "${packages[@]}"
}

# --- Core operations ---

install_homebrew() {
    if command_exists brew; then
        ok "Homebrew already installed"
        return 0
    fi

    info "Installing Homebrew..."
    local brew_log
    brew_log=$(mktemp)
    if ! NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" &>"$brew_log"; then
        err "Homebrew installation failed"
        echo "--- Last 20 lines of output ---"
        tail -20 "$brew_log"
        echo "---"
        info "Troubleshooting:"
        info "  - Check disk space: df -h"
        info "  - Check network: curl -fsSL https://github.com"
        info "  - Manual install: https://brew.sh"
        rm -f "$brew_log"
        return 1
    fi
    rm -f "$brew_log"

    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)" || true
    elif [[ -f /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)" || true
    elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" || true
    fi
    ok "Homebrew installed"
}

install_brew_packages() {
    if [[ ! -f "$BREWFILE" ]]; then
        err "Brewfile not found at $BREWFILE"
        return 1
    fi

    info "Installing packages from Brewfile..."
    if brew bundle --file="$BREWFILE"; then
        ok "All packages installed"
        return 0
    fi

    warn "brew bundle failed, installing individually..."
    local failed=()
    local count=0

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            local pkg="${BASH_REMATCH[1]}"
            if brew install "$pkg" 2>/dev/null; then
                ((++count))
            else
                failed+=("brew:$pkg")
            fi
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            local pkg="${BASH_REMATCH[1]}"
            if brew install --cask "$pkg" 2>/dev/null; then
                ((++count))
            else
                failed+=("cask:$pkg")
            fi
        fi
    done < "$BREWFILE"

    if [[ ${#failed[@]} -gt 0 ]]; then
        warn "Failed to install ${#failed[@]} packages:"
        printf "  - %s\n" "${failed[@]}"
        local failed_file="${PACKAGES_DIR}/failed_packages_$(date +%Y%m%d_%H%M%S).txt"
        printf "%s\n" "${failed[@]}" > "$failed_file"
        info "Failures saved to $failed_file"
    fi

    ok "Installed $count packages"
}

install_pacman_packages() {
    if [[ ! -f "$PACFILE" ]]; then
        err "Pacfile not found at $PACFILE"
        return 1
    fi

    local pacman_pkgs=() aur_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^\[aur\][[:space:]]+(.+)$ ]]; then
            aur_pkgs+=("${BASH_REMATCH[1]}")
        else
            pacman_pkgs+=("${line#"${line%%[![:space:]]*}"}")
        fi
    done < "$PACFILE"

    local failed=()

    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        info "Installing ${#pacman_pkgs[@]} pacman packages..."
        if ! sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"; then
            warn "Some pacman packages failed to install"
            for pkg in "${pacman_pkgs[@]}"; do
                if ! pacman -Qi "$pkg" &>/dev/null; then
                    failed+=("pacman:$pkg")
                fi
            done
        fi
    fi

    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        local helper
        helper="$(aur_helper)"
        if [[ -z "$helper" ]]; then
            warn "No AUR helper found (yay or paru). Skipping AUR packages:"
            printf "  - %s\n" "${aur_pkgs[@]}"
            for pkg in "${aur_pkgs[@]}"; do
                failed+=("aur:$pkg")
            done
        else
            info "Installing ${#aur_pkgs[@]} AUR packages via $helper..."
            if ! "$helper" -S --needed --noconfirm "${aur_pkgs[@]}"; then
                warn "Some AUR packages failed to install"
                for pkg in "${aur_pkgs[@]}"; do
                    if ! pacman -Qi "$pkg" &>/dev/null; then
                        failed+=("aur:$pkg")
                    fi
                done
            fi
        fi
    fi

    if [[ ${#failed[@]} -gt 0 ]]; then
        warn "Failed to install ${#failed[@]} packages:"
        printf "  - %s\n" "${failed[@]}"
        local failed_file="${PACKAGES_DIR}/failed_packages_$(date +%Y%m%d_%H%M%S).txt"
        printf "%s\n" "${failed[@]}" > "$failed_file"
        info "Failures saved to $failed_file"
    fi

    ok "Package installation complete"
}

install_npm_globals() {
    info "Installing global npm packages..."
    npm install -g opensrc
    ok "Global npm packages installed"
}

setup_shell() {
    local zsh_path
    zsh_path="$(command -v zsh)"

    if [[ "$SHELL" == "$zsh_path" ]]; then
        ok "zsh is already the default shell"
        return 0
    fi

    info "Setting zsh as default shell..."
    if ! grep -qF "$zsh_path" /etc/shells; then
        echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
    fi
    chsh -s "$zsh_path"
    ok "Default shell set to zsh"
}

backup_conflicts() {
    local files_to_backup=()
    local packages=()
    while IFS= read -r pkg; do packages+=("$pkg"); done < <(stow_packages)

    for pkg in "${packages[@]}"; do
        while IFS= read -r -d '' file; do
            local rel="${file#"${DOTFILES_DIR}/${pkg}"/}"
            local target="${HOME}/${rel}"
            if [[ -e "$target" && ! -L "$target" ]]; then
                files_to_backup+=("$rel")
            fi
        done < <(find "${DOTFILES_DIR}/${pkg}" -type f -print0)
    done

    if [[ ${#files_to_backup[@]} -eq 0 ]]; then
        return 0
    fi

    warn "These existing files would be replaced:"
    printf "  %s\n" "${files_to_backup[@]}"

    if confirm "Back them up first?" "y"; then
        local backup_dir="${DOTFILES_DIR}/backups/$(date +%Y%m%d_%H%M%S)"
        mkdir -p "$backup_dir"
        for file in "${files_to_backup[@]}"; do
            local src="${HOME}/${file}"
            local dst="${backup_dir}/${file}"
            mkdir -p "$(dirname "$dst")"
            cp -p "$src" "$dst"
        done
        ok "Backups created in $backup_dir"
    fi
}

install_cli_tools() {
    if ! command_exists claude; then
        if confirm "Install Claude Code?" "y"; then
            info "Installing Claude Code..."
            curl -fsSL https://claude.ai/install.sh | bash
        fi
    else
        ok "Claude Code already installed"
    fi

    if ! command_exists opencode; then
        if confirm "Install OpenCode?" "y"; then
            info "Installing OpenCode..."
            curl -fsSL https://opencode.ai/install | bash
        fi
    else
        ok "OpenCode already installed"
    fi
}

# --- Commands ---

cmd_init() {
    info "Initializing dotfiles (platform: $PLATFORM)"

    case "$PLATFORM" in
        arch)
            local total=5
            step 1 $total "Installing packages"
            install_pacman_packages
            step 2 $total "Installing CLI tools"
            install_cli_tools
            step 3 $total "Backing up conflicts"
            backup_conflicts
            step 4 $total "Stowing dotfiles"
            cmd_stow
            step 5 $total "Setting up shell"
            setup_shell
            ;;
        *)
            local total=7
            step 1 $total "Installing Homebrew"
            install_homebrew
            step 2 $total "Installing packages"
            install_brew_packages
            step 3 $total "Installing npm globals"
            install_npm_globals
            step 4 $total "Installing CLI tools"
            install_cli_tools
            step 5 $total "Backing up conflicts"
            backup_conflicts
            step 6 $total "Stowing dotfiles"
            cmd_stow
            step 7 $total "Setting up shell"
            setup_shell
            ;;
    esac

    echo ""
    ok "Setup complete. Open a new terminal to start using your config."
}

cmd_stow() {
    if ! command_exists stow; then
        err "GNU Stow is not installed ($(install_hint stow))"
        return 1
    fi
    local packages=()
    while IFS= read -r pkg; do packages+=("$pkg"); done < <(stow_packages)
    info "Stowing dotfiles (${packages[*]})..."
    stow -R --no-folding --dir="$DOTFILES_DIR" --target="$HOME" "${packages[@]}"
    ok "Dotfiles linked"
}

cmd_update() {
    info "Updating dotfiles"

    info "Pulling latest changes..."
    if git -C "$DOTFILES_DIR" pull; then
        ok "Repository updated"
    else
        err "Failed to pull latest changes"
        return 1
    fi

    # Re-exec with the freshly-pulled script so structural changes take effect
    exec "$DOTFILES_DIR/dot" _update-post-pull "$@"
}

cmd_update_post_pull() {
    case "$PLATFORM" in
        arch)
            if confirm "Update system packages?" "y"; then
                info "Updating pacman packages..."
                sudo pacman -Syu
                local helper
                helper="$(aur_helper)"
                if [[ -n "$helper" ]]; then
                    info "Updating AUR packages..."
                    "$helper" -Syu
                fi
                ok "Packages updated"
            fi
            ;;
        *)
            if confirm "Update Homebrew packages?" "y"; then
                info "Updating Homebrew..."
                brew update && brew upgrade
                ok "Packages updated"
            fi
            ;;
    esac

    cmd_stow
}

cmd_doctor() {
    info "Running diagnostics (platform: $PLATFORM)"
    local issues=0

    # Package manager
    case "$PLATFORM" in
        arch)
            if command_exists pacman; then
                ok "pacman available"
            else
                warn "pacman not found"
                ((++issues))
            fi
            local helper
            helper="$(aur_helper)"
            if [[ -n "$helper" ]]; then
                ok "AUR helper: $helper"
            else
                warn "No AUR helper found (yay or paru)"
                info "  -> install yay or paru for AUR support"
                ((++issues))
            fi
            ;;
        *)
            if command_exists brew; then
                ok "Homebrew installed"
            else
                warn "Homebrew not found"
                info "  -> dot init"
                ((++issues))
            fi
            ;;
    esac

    # Core tools
    local tools=(stow zsh git tmux)
    for tool in "${tools[@]}"; do
        if command_exists "$tool"; then
            ok "$tool installed"
        else
            warn "$tool not found"
            info "  -> $(install_hint "$tool")"
            ((++issues))
        fi
    done

    # Default shell
    if [[ "$SHELL" == *"zsh"* ]]; then
        ok "zsh is default shell"
    else
        warn "zsh is not default shell (currently $SHELL)"
        info "  -> chsh -s \$(command -v zsh)"
        ((++issues))
    fi

    # Broken stow symlinks (only links pointing into dotfiles dir)
    local broken=0
    local broken_list=()
    while IFS= read -r -d '' link; do
        local target
        target=$(readlink "$link" 2>/dev/null || true)
        if [[ "$target" == *".dotfiles"* && ! -e "$link" ]]; then
            ((++broken))
            broken_list+=("$link")
        fi
    done < <(find "$HOME" -maxdepth 3 -type l -print0 2>/dev/null)

    if [[ $broken -eq 0 ]]; then
        ok "No broken stow symlinks"
    else
        warn "Found $broken broken stow symlinks:"
        printf "  %s\n" "${broken_list[@]}"
        info "  -> dot stow"
        ((++issues))
    fi

    # SSH key
    if [[ -f "$HOME/.ssh/id_ed25519.pub" || -f "$HOME/.ssh/id_rsa.pub" ]]; then
        ok "SSH key exists"
    else
        warn "No SSH key found"
        info "  -> dot gen-ssh-key"
    fi

    # dot command available
    if command_exists dot; then
        ok "dot command available"
    else
        warn "dot not in PATH -- run 'dot link' to fix"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        ok "All checks passed"
    else
        warn "Found $issues issue(s)"
    fi
}

cmd_package() {
    local subcmd="${1:-list}"
    shift || true

    case "$subcmd" in
        add)    cmd_package_add "$@" ;;
        remove) cmd_package_remove "$@" ;;
        list)   cmd_package_list ;;
        -h|--help|help) cmd_package_help ;;
        *)
            err "Unknown package subcommand: $subcmd"
            cmd_package_help
            return 1
            ;;
    esac
}

cmd_package_add() {
    case "$PLATFORM" in
        arch) cmd_package_add_pacman "$@" ;;
        *)    cmd_package_add_brew "$@" ;;
    esac
}

cmd_package_add_brew() {
    local name="${1:-}" type="${2:-auto}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package add <name> [brew|cask]"
        return 1
    fi

    # Auto-detect type
    if [[ "$type" == "auto" ]]; then
        if brew info --json=v2 --formula "$name" &>/dev/null; then
            type="brew"
        elif brew info --json=v2 --cask "$name" &>/dev/null; then
            type="cask"
        else
            warn "Package '$name' not found, defaulting to brew formula"
            type="brew"
        fi
    fi

    local entry="${type} \"${name}\""

    # Check if already in Brewfile
    if grep -qF "$entry" "$BREWFILE" 2>/dev/null; then
        warn "'$name' already in Brewfile"
        return 0
    fi

    # Install
    info "Installing $name..."
    if [[ "$type" == "cask" ]]; then
        brew install --cask "$name"
    else
        brew install "$name"
    fi

    # Add to Brewfile in sorted position within same type
    local tmp
    tmp=$(mktemp)
    local inserted=false

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$inserted" == false && "$line" =~ ^${type}[[:space:]]+\"([^\"]+)\" ]]; then
            local existing="${BASH_REMATCH[1]}"
            if [[ "$name" < "$existing" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
        fi
        echo "$line" >> "$tmp"
    done < "$BREWFILE"

    if [[ "$inserted" == false ]]; then
        echo "$entry" >> "$tmp"
    fi

    mv "$tmp" "$BREWFILE"
    ok "Added '$name' ($type) to Brewfile"
}

cmd_package_add_pacman() {
    local name="${1:-}" type="${2:-auto}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package add <name> [pacman|aur]"
        return 1
    fi

    # Auto-detect type
    if [[ "$type" == "auto" ]]; then
        if pacman -Si "$name" &>/dev/null; then
            type="pacman"
        else
            local helper
            helper="$(aur_helper)"
            if [[ -n "$helper" ]] && "$helper" -Si "$name" &>/dev/null; then
                type="aur"
            else
                warn "Package '$name' not found in repos or AUR, defaulting to pacman"
                type="pacman"
            fi
        fi
    fi

    local entry
    if [[ "$type" == "aur" ]]; then
        entry="[aur] ${name}"
    else
        entry="$name"
    fi

    # Check if already in Pacfile
    if grep -qxF "$entry" "$PACFILE" 2>/dev/null; then
        warn "'$name' already in Pacfile"
        return 0
    fi

    # Install
    info "Installing $name..."
    if [[ "$type" == "aur" ]]; then
        local helper
        helper="$(aur_helper)"
        if [[ -z "$helper" ]]; then
            err "No AUR helper available to install '$name'"
            return 1
        fi
        "$helper" -S --needed "$name"
    else
        sudo pacman -S --needed "$name"
    fi

    # Insert sorted into Pacfile
    if [[ "$type" == "aur" ]]; then
        # Insert among AUR entries (lines starting with [aur])
        local tmp
        tmp=$(mktemp)
        local inserted=false
        while IFS= read -r line; do
            if [[ "$inserted" == false && "$line" =~ ^\[aur\] ]] && [[ "$entry" < "$line" || "$entry" == "$line" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
            echo "$line" >> "$tmp"
        done < "$PACFILE"
        if [[ "$inserted" == false ]]; then
            echo "$entry" >> "$tmp"
        fi
        mv "$tmp" "$PACFILE"
    else
        # Insert among non-AUR, non-comment, non-empty lines in sorted position
        local tmp
        tmp=$(mktemp)
        local inserted=false
        while IFS= read -r line; do
            if [[ "$inserted" == false ]] && [[ ! "$line" =~ ^[[:space:]]*# ]] && [[ -n "${line// }" ]] && [[ ! "$line" =~ ^\[aur\] ]] && [[ "$entry" < "$line" ]]; then
                echo "$entry" >> "$tmp"
                inserted=true
            fi
            echo "$line" >> "$tmp"
        done < "$PACFILE"
        if [[ "$inserted" == false ]]; then
            # Insert before the AUR section if it exists
            local aur_line
            aur_line=$(grep -n '^\[aur\]' "$tmp" | head -1 | cut -d: -f1)
            if [[ -n "$aur_line" ]]; then
                sed -i "${aur_line}i\\${entry}" "$tmp"
            else
                echo "$entry" >> "$tmp"
            fi
        fi
        mv "$tmp" "$PACFILE"
    fi
    ok "Added '$name' ($type) to Pacfile"
}

cmd_package_remove() {
    case "$PLATFORM" in
        arch) cmd_package_remove_pacman "$@" ;;
        *)    cmd_package_remove_brew "$@" ;;
    esac
}

cmd_package_remove_brew() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package remove <name>"
        return 1
    fi

    local escaped
    escaped=$(printf '%s' "$name" | sed 's/[.[*^$()+?{|\\]/\\&/g')

    if ! grep -q "^\(brew\|cask\)[[:space:]]*\"${escaped}\"" "$BREWFILE" 2>/dev/null; then
        warn "'$name' not found in Brewfile"
        return 0
    fi

    # Remove from Brewfile
    local tmp
    tmp=$(mktemp)
    grep -v "^\(brew\|cask\)[[:space:]]*\"${escaped}\"" "$BREWFILE" > "$tmp"
    mv "$tmp" "$BREWFILE"
    ok "Removed '$name' from Brewfile"

    if confirm "Also uninstall '$name' from system?" "n"; then
        brew uninstall "$name" 2>/dev/null || brew uninstall --cask "$name" 2>/dev/null || warn "Could not uninstall '$name'"
    fi
}

cmd_package_remove_pacman() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        err "Usage: dot package remove <name>"
        return 1
    fi

    local found=false
    local tmp
    tmp=$(mktemp)

    while IFS= read -r line; do
        if [[ "$line" == "$name" || "$line" == "[aur] $name" ]]; then
            found=true
            continue
        fi
        echo "$line" >> "$tmp"
    done < "$PACFILE"

    if [[ "$found" == false ]]; then
        warn "'$name' not found in Pacfile"
        rm -f "$tmp"
        return 0
    fi

    mv "$tmp" "$PACFILE"
    ok "Removed '$name' from Pacfile"

    if confirm "Also uninstall '$name' from system?" "n"; then
        sudo pacman -R "$name" 2>/dev/null || warn "Could not uninstall '$name'"
    fi
}

cmd_package_list() {
    case "$PLATFORM" in
        arch) cmd_package_list_pacman ;;
        *)    cmd_package_list_brew ;;
    esac
}

cmd_package_list_brew() {
    if [[ ! -f "$BREWFILE" ]]; then
        err "Brewfile not found"
        return 1
    fi

    local installed_formulas installed_casks
    installed_formulas=$(brew list --formula 2>/dev/null || true)
    installed_casks=$(brew list --cask 2>/dev/null || true)

    local brew_pkgs=() cask_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^brew[[:space:]]+\"([^\"]+)\" ]]; then
            brew_pkgs+=("${BASH_REMATCH[1]}")
        elif [[ "$line" =~ ^cask[[:space:]]+\"([^\"]+)\" ]]; then
            cask_pkgs+=("${BASH_REMATCH[1]}")
        fi
    done < "$BREWFILE"

    if [[ ${#brew_pkgs[@]} -gt 0 ]]; then
        echo "Formulas (${#brew_pkgs[@]}):"
        for pkg in "${brew_pkgs[@]}"; do
            if echo "$installed_formulas" | grep -q "^${pkg}$"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi

    if [[ ${#cask_pkgs[@]} -gt 0 ]]; then
        echo "Casks (${#cask_pkgs[@]}):"
        for pkg in "${cask_pkgs[@]}"; do
            if echo "$installed_casks" | grep -q "^${pkg}$"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi
}

cmd_package_list_pacman() {
    if [[ ! -f "$PACFILE" ]]; then
        err "Pacfile not found"
        return 1
    fi

    local installed
    installed=$(pacman -Qq 2>/dev/null || true)

    local pacman_pkgs=() aur_pkgs=()

    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        if [[ "$line" =~ ^\[aur\][[:space:]]+(.+)$ ]]; then
            aur_pkgs+=("${BASH_REMATCH[1]}")
        else
            pacman_pkgs+=("${line#"${line%%[![:space:]]*}"}")
        fi
    done < "$PACFILE"

    if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
        echo "Pacman (${#pacman_pkgs[@]}):"
        for pkg in "${pacman_pkgs[@]}"; do
            if echo "$installed" | grep -qx "$pkg"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi

    if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
        echo "AUR (${#aur_pkgs[@]}):"
        for pkg in "${aur_pkgs[@]}"; do
            if echo "$installed" | grep -qx "$pkg"; then
                ok "  $pkg"
            else
                err "  $pkg (not installed)"
            fi
        done
    fi
}

cmd_package_help() {
    if [[ "$PLATFORM" == "arch" ]]; then
        cat <<EOF
dot package - Pacfile management

USAGE: dot package <subcommand> [args]

SUBCOMMANDS:
    add <name> [pacman|aur]  Install and add to Pacfile (auto-detects type)
    remove <name>            Remove from Pacfile, optionally uninstall
    list                     Show packages with install status
    help                     This message
EOF
    else
        cat <<EOF
dot package - Brewfile management

USAGE: dot package <subcommand> [args]

SUBCOMMANDS:
    add <name> [brew|cask]  Install and add to Brewfile (auto-detects type)
    remove <name>           Remove from Brewfile, optionally uninstall
    list                    Show packages with install status
    help                    This message
EOF
    fi
}

cmd_retry_failed() {
    local failed_file
    failed_file=$(find "$PACKAGES_DIR" -name "failed_packages_*.txt" -type f 2>/dev/null | sort -r | head -1)

    if [[ -z "$failed_file" || ! -f "$failed_file" ]]; then
        info "No failed packages to retry"
        return 0
    fi

    info "Retrying from $failed_file..."
    local success=0 total=0

    while IFS= read -r entry; do
        ((++total))
        if [[ "$entry" =~ ^brew:(.+)$ ]]; then
            if brew install "${BASH_REMATCH[1]}" 2>/dev/null; then
                ok "Installed ${BASH_REMATCH[1]}"
                ((++success))
            else
                warn "Still failing: ${BASH_REMATCH[1]}"
            fi
        elif [[ "$entry" =~ ^cask:(.+)$ ]]; then
            if brew install --cask "${BASH_REMATCH[1]}" 2>/dev/null; then
                ok "Installed ${BASH_REMATCH[1]}"
                ((++success))
            else
                warn "Still failing: ${BASH_REMATCH[1]}"
            fi
        elif [[ "$entry" =~ ^pacman:(.+)$ ]]; then
            if sudo pacman -S --needed --noconfirm "${BASH_REMATCH[1]}" 2>/dev/null; then
                ok "Installed ${BASH_REMATCH[1]}"
                ((++success))
            else
                warn "Still failing: ${BASH_REMATCH[1]}"
            fi
        elif [[ "$entry" =~ ^aur:(.+)$ ]]; then
            local helper
            helper="$(aur_helper)"
            if [[ -n "$helper" ]] && "$helper" -S --needed --noconfirm "${BASH_REMATCH[1]}" 2>/dev/null; then
                ok "Installed ${BASH_REMATCH[1]}"
                ((++success))
            else
                warn "Still failing: ${BASH_REMATCH[1]}"
            fi
        fi
    done < "$failed_file"

    info "Retried $total, succeeded $success"
    if [[ $success -eq $total ]]; then
        rm "$failed_file"
        ok "All failures resolved"
    fi
}

cmd_link() {
    local target_dir="${HOME}/.local/bin"
    mkdir -p "$target_dir"

    local link_path="${target_dir}/dot"
    [[ -L "$link_path" ]] && rm "$link_path"

    ln -s "${DOTFILES_DIR}/dot" "$link_path"
    ok "Linked dot -> $link_path"
    info "Ensure $target_dir is in your PATH"
}

cmd_unlink() {
    local paths=("${HOME}/.local/bin/dot" "/usr/local/bin/dot")
    local found=false

    for p in "${paths[@]}"; do
        if [[ -L "$p" ]]; then
            rm "$p"
            ok "Removed $p"
            found=true
        fi
    done

    if [[ "$found" == false ]]; then
        warn "No dot symlink found"
    fi
}

cmd_edit() {
    exec "${EDITOR:-nvim}" "$DOTFILES_DIR"
}

cmd_gen_ssh_key() {
    local email="${1:-}"
    if [[ -z "$email" ]]; then
        email=$(git config user.email 2>/dev/null || true)
    fi
    if [[ -z "$email" ]]; then
        err "No email provided and git user.email not set"
        err "Usage: dot gen-ssh-key [email]"
        return 1
    fi

    local key_path="$HOME/.ssh/id_ed25519"

    if [[ -f "$key_path" ]]; then
        warn "SSH key already exists at $key_path"
        if ! confirm "Overwrite? (old key will be backed up)" "n"; then
            return 0
        fi
        local backup="${key_path}.bak.$(date +%Y%m%d_%H%M%S)"
        cp "$key_path" "$backup"
        cp "${key_path}.pub" "${backup}.pub" 2>/dev/null || true
        ok "Backed up existing key to $backup"
    fi

    info "Generating ed25519 SSH key for $email..."
    mkdir -p "$HOME/.ssh"
    ssh-keygen -t ed25519 -C "$email" -f "$key_path"

    # Start ssh-agent if not running
    if ! ssh-add -l &>/dev/null; then
        eval "$(ssh-agent -s)" >/dev/null
    fi
    ssh-add "$key_path" 2>/dev/null

    # Copy to clipboard if possible
    local pubkey
    pubkey=$(<"${key_path}.pub")
    if command_exists wl-copy; then
        echo "$pubkey" | wl-copy
        ok "Public key copied to clipboard (wl-copy)"
    elif command_exists xclip; then
        echo "$pubkey" | xclip -selection clipboard
        ok "Public key copied to clipboard (xclip)"
    elif command_exists pbcopy; then
        echo "$pubkey" | pbcopy
        ok "Public key copied to clipboard (pbcopy)"
    else
        info "Public key (copy manually):"
        echo "$pubkey"
    fi

    echo ""
    info "Next steps:"
    info "  GitHub:  https://github.com/settings/ssh/new"
    info "  GitLab:  https://gitlab.com/-/user_settings/ssh_keys"
}

cmd_completions() {
    local func_dir="${DOTFILES_DIR}/home-common/.config/zsh/functions"
    mkdir -p "$func_dir"

    cat > "${func_dir}/_dot" <<'COMP'
#compdef dot

_dot() {
    local -a commands
    commands=(
        'init:Full bootstrap (packages, stow, shell)'
        'stow:Re-stow dotfiles'
        'update:Pull latest, update packages, re-stow'
        'doctor:Check tools, symlinks, shell health'
        'package:Package management (add/remove/list)'
        'retry-failed:Retry failed package installations'
        'link:Symlink dot into PATH'
        'unlink:Remove dot symlink'
        'edit:Open dotfiles in $EDITOR'
        'gen-ssh-key:Generate ed25519 SSH key'
        'completions:Generate zsh completions'
        'help:Show help message'
    )

    local -a global_opts
    global_opts=(
        '--version[Show version]'
        '(-h --help)'{-h,--help}'[Show help]'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'dot command' commands
        _arguments -s $global_opts
        return
    fi

    case "$words[2]" in
        package)
            local -a subcmds
            subcmds=(
                'add:Install and add to package list'
                'remove:Remove from package list'
                'list:Show packages with install status'
                'help:Show package help'
            )
            if (( CURRENT == 3 )); then
                _describe -t subcmds 'package subcommand' subcmds
            fi
            ;;
    esac
}

_dot "$@"
COMP

    ok "Generated completions at ${func_dir}/_dot"
    info "Run 'dot stow' then open a new shell to activate"
}

cmd_help() {
    cat <<EOF
dot v${VERSION} - dotfiles management (platform: $PLATFORM)

USAGE: dot [command] [args]

COMMANDS:
    init            Full bootstrap (packages, stow, shell)
    stow            Re-stow dotfiles
    update          Pull latest, update packages, re-stow
    doctor          Check tools, symlinks, shell health
    package         Package management (add/remove/list)
    retry-failed    Retry failed package installations
    link            Symlink dot into PATH (~/.local/bin)
    unlink          Remove dot symlink
    edit            Open dotfiles in \$EDITOR
    gen-ssh-key     Generate ed25519 SSH key
    completions     Generate zsh completions
    help            This message

OPTIONS:
    --version       Show version
    -h, --help      This message
EOF
}

# --- Main ---

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --version) echo "dot v${VERSION}"; exit 0 ;;
            -h|--help) cmd_help; exit 0 ;;
            *) break ;;
        esac
    done

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        init)                cmd_init "$@" ;;
        stow)                cmd_stow "$@" ;;
        update)              cmd_update "$@" ;;
        _update-post-pull)   cmd_update_post_pull "$@" ;;
        doctor)              cmd_doctor "$@" ;;
        package)             cmd_package "$@" ;;
        retry-failed)        cmd_retry_failed "$@" ;;
        link)                cmd_link "$@" ;;
        unlink)              cmd_unlink "$@" ;;
        edit)                cmd_edit "$@" ;;
        gen-ssh-key)         cmd_gen_ssh_key "$@" ;;
        completions)         cmd_completions "$@" ;;
        help)                cmd_help ;;
        *)
            err "Unknown command: $cmd"
            echo "Run 'dot help' for usage"
            exit 1
            ;;
    esac
}

main "$@"
