# Ignores for when this directory is stowed as a package in its own right,
# targeting ~/.claude-<account> (see stow_claude_account in ../../dot).
# Mirrors the .claude entries of ../.stow-local-ignore, re-anchored to this
# root; keep the two in step.

# Repeat stow's default ignores (since this file replaces them).
\.git
\.gitignore
\.gitmodules
\.hg
\.svn
^README.*
^LICENSE.*

# Merged into settings.json by dot's sync_settings() rather than linked.
^/settings\.base\.json$

# Claude Code mods. Published by dot's stow_mods() into ~/.claude/mods only;
# every account's settings point there.
^/mods$
