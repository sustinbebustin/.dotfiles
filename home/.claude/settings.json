{
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5[1m]",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "226000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Edit",
      "MultiEdit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(supabase db diff:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(*/.claude/hooks/*)",
      "Bash(*/.agents/hooks/*)",
      "Bash(bash */.claude/skills/*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(tee:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(env:*)",
      "Bash(set:*)",
      "Bash(uv run:*)",
      "Bash(continuity:*)",
      "Bash(mcp-exec:*)",
      "Bash(mcp-generate:*)",
      "Bash(mcp-discover:*)",
      "Bash(rp-cli:*)",
      "Bash(sqlite3:*)",
      "Bash(pipx:*)",
      "Bash(uvx:*)",
      "Bash(pytest:*)",
      "Bash(qlty:*)",
      "Bash(rm /tmp:*)",
      "Bash(rm -f /tmp:*)",
      "Bash(rm -r /tmp:*)",
      "Bash(rm -rf /tmp:*)",
      "Bash(rm -fr /tmp:*)",
      "mcp__git__*",
      "mcp__opensrc__*",
      "mcp__context7__*",
      "mcp__grep_app__*",
      "mcp__codesearch__*",
      "mcp__ide__getDiagnostics",
      "Read($HOME/.claude/**)",
      "Read(~/.claude/**)",
      "mcp__supabase__*",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__generate_typescript_types"
    ],
    "deny": [
      "Bash(wget:*)",
      "Bash(brew install:*)",
      "Read(**/.env)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.env)",
      "Read(**/secrets.enc)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Skill(release)",
      "Skill(release *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/block-env-files-bin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/block-aws-cli-bin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/block-dangerous-git-bin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/block-dangerous-rm-bin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/enforce-root-bin"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Dedicated File Tools: using Read, Edit, Write, Grep, or Glob for any file read, search, edit, or creation is always allowed and is the preferred way to do file work in this environment. Routing that work through Bash instead -- cat, head, tail, sed, awk, find, heredocs, redirection, or throwaway scripts -- is not preferred here, even where the shell command would itself be permitted. Bash is for running real programs: builds, tests, git, package managers, linters, and other CLIs.",
      "Running a pre-existing skill helper script at ~/.claude/skills/*/scripts/gather-state.sh is allowed, regardless of how it was invoked, when all of these hold: the agent did not write or edit the script this session (if the transcript shows the agent writing or editing it, judge the written content instead); the script invocation is the whole command, taking no arguments other than a quoted heredoc carrying the slash-command's own arguments; and the script only reads local git and repo state. This covers running the script only -- creating or editing files under .claude/skills/ remains Self-Modification and is not cleared here."
    ]
  },
  "voiceEnabled": false
}
