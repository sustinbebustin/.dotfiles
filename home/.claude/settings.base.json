{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "IMPECCABLE_CONTEXT_DIR": ".impeccable"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit",
      "MultiEdit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(supabase db diff:*)",
      "Bash(*/.claude/hooks/*)",
      "Bash(bash */.claude/skills/*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(tee:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(set:*)",
      "Bash(uv run:*)",
      "Bash(continuity:*)",
      "Bash(mcp-exec:*)",
      "Bash(mcp-generate:*)",
      "Bash(mcp-discover:*)",
      "Bash(rp-cli:*)",
      "Bash(sqlite3:*)",
      "Bash(pipx:*)",
      "Bash(uvx:*)",
      "Bash(pytest:*)",
      "Bash(qlty:*)",
      "mcp__git__*",
      "mcp__opensrc__*",
      "mcp__context7__*",
      "mcp__grep_app__*",
      "mcp__codesearch__*",
      "mcp__ide__getDiagnostics",
      "Read($HOME/.claude/**)",
      "Read(~/.claude/**)",
      "mcp__supabase__*",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__generate_typescript_types"
    ],
    "deny": [
      "Bash(wget:*)",
      "Bash(brew install:*)"
    ],
    "ask": [
      "Skill(release)",
      "Skill(release *)"
    ]
  },
  "skillOverrides": {
    "better-error-messages": "name-only",
    "doc-generator": "user-invocable-only",
    "fix-merge-conflicts": "name-only",
    "gh-fix-ci": "name-only",
    "impeccable": "name-only",
    "librarian": "name-only",
    "prototype": "name-only",
    "sentry-cli": "name-only",
    "stack": "name-only",
    "summarize": "name-only",
    "wizard": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-hooks-bin"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-quality-bin",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
