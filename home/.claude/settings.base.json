{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "IMPECCABLE_CONTEXT_DIR": ".impeccable",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Edit",
      "MultiEdit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(supabase db diff:*)",
      "Bash(*/.agents/hooks/*)",
      "Bash(bash */.claude/skills/*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(tee:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(set:*)",
      "Bash(uv run:*)",
      "Bash(pipx:*)",
      "Bash(uvx:*)",
      "Bash(pytest:*)",
      "Bash(qlty:*)",
      "mcp__context7__*",
      "mcp__ide__getDiagnostics",
      "Read($HOME/.claude/**)",
      "Read(~/.claude/**)"
    ],
    "deny": [
      "Bash(wget:*)",
      "Bash(brew install:*)"
    ],
    "ask": [
      "Skill(release)",
      "Skill(release *)"
    ]
  },
  "skillOverrides": {
    "better-error-messages": "name-only",
    "claude-docs": "name-only",
    "code-review": "name-only",
    "create-agents": "name-only",
    "create-mod": "name-only",
    "create-plugins": "name-only",
    "create-skills": "name-only",
    "doc-generator": "name-only",
    "domain-modeling": "name-only",
    "elevenlabs-tts": "name-only",
    "fix-merge-conflicts": "name-only",
    "gh-fix-ci": "name-only",
    "gh-stack": "name-only",
    "grilling": "name-only",
    "handoff": "name-only",
    "impeccable": "name-only",
    "implement": "name-only",
    "librarian": "name-only",
    "opentui": "name-only",
    "pr": "name-only",
    "principle-boundary-discipline": "name-only",
    "principle-type-system-discipline": "name-only",
    "prototype": "name-only",
    "rebase": "name-only",
    "sentry-cli": "name-only",
    "statechart": "name-only",
    "summarize": "name-only",
    "test-audit": "name-only",
    "to-spec": "name-only",
    "to-tickets": "name-only",
    "watch-ci": "name-only",
    "wizard": "name-only",
    "writing-for-agents": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/agent-guard-bin"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/agent-quality-bin",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.agents/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
