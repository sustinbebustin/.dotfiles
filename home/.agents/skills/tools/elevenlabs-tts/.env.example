# Copy to .env (gitignored) in this directory and fill in.
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID: open the voice in https://elevenlabs.io/app/voice-lab and copy its ID
ELEVENLABS_VOICE_ID=
# Optional; defaults to eleven_v4. Others: eleven_multilingual_v2, eleven_flash_v2_5, eleven_v3
ELEVENLABS_MODEL_ID=
