{
  "dangerousRm": {
    "allowedRoots": [
      "~/dev/example-project"
    ]
  },
  "credentialFiles": {
    "relaxedRoots": [
      "~/dev/example-project"
    ]
  },
  "awsCli": {
    "profiles": {
      "sandbox": "allow",
      "work": "readOnly",
      "prod": "deny"
    }
  },
  "grants": {
    "skills": {
      "deploy": {
        "roots": [
          "~/dev/example-project"
        ],
        "allow": [
          "prMerge",
          "workflowRun",
          "releaseCreate",
          "pushMain"
        ],
        "confirm": "Proceed"
      }
    }
  }
}
