# Stow ignores. Patterns are anchored at the package root with a leading "/".
# When this file exists, stow uses ONLY these patterns (not its built-in defaults),
# so common VCS / metadata patterns are repeated explicitly below.

# Repeat stow's default ignores (since this file replaces them).
\.git
\.gitignore
\.gitmodules
\.hg
\.svn
^README.*
^LICENSE.*

# Go source dirs for the hook binaries -- only the built *-bin should be linked.
^/\.agents/hooks/cmd$
^/\.agents/hooks/internal$

# Build tooling for those binaries; not needed in ~/.agents/hooks.
^/\.agents/hooks/Makefile$
^/\.agents/hooks/go\.mod$
^/\.agents/hooks/go\.sum$
^/\.agents/hooks/\.golangci\.yml$

# The droid generator. dot runs it from the repo; no harness invokes it.
^/\.agents/hooks/agent-droids-bin$

# The template for the hook's machine-local settings. The real config.json is
# gitignored and deliberately NOT ignored here: the binary reads it from
# ~/.agents/hooks/config.json, so it has to be linked like the binary is.
^/\.agents/hooks/config\.json\.example$

# The skills tree. Published by dot's stow_skills() instead -- categories
# flattened, each skill linked as a folder.
^/\.agents/skills$

# Published by dot's link_shared_dirs() instead, as one dir link per harness.
^/\.agents/commands$
^/\.agents/agents$

# Merged into settings.json by dot's sync_settings() rather than linked.
^/\.claude/settings\.base\.json$
^/\.factory/settings\.base\.json$

# Ignores for stowing .claude on its own into ~/.claude-<account>; meaningless
# inside ~/.claude itself.
^/\.claude/\.stow-local-ignore$

# Claude Code mods. Published by dot's stow_mods() instead -- each mod linked
# as a folder, since the plugin loader rejects per-file links.
^/\.claude/mods$
