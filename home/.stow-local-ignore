# Stow ignores. Patterns are anchored at the package root with a leading "/".
# When this file exists, stow uses ONLY these patterns (not its built-in defaults),
# so common VCS / metadata patterns are repeated explicitly below.

# Repeat stow's default ignores (since this file replaces them).
\.git
\.gitignore
\.gitmodules
\.hg
\.svn
^README.*
^LICENSE.*

# Go source dirs for the hook binaries — only the built *-bin should be linked.
# The tree lives under .agents/ because Claude Code and Codex both point their
# hook configs at ~/.agents/hooks; unlike skills, one location serves both.
^/\.agents/hooks/block-aws-cli$
^/\.agents/hooks/block-dangerous-git$
^/\.agents/hooks/block-dangerous-rm$
^/\.agents/hooks/block-env-files$
^/\.agents/hooks/enforce-root$
^/\.agents/hooks/internal$

# Build tooling for those binaries; not needed in ~/.agents/hooks.
^/\.agents/hooks/Makefile$
^/\.agents/hooks/go\.mod$
^/\.agents/hooks/go\.sum$

# The canonical skills tree. Published by dot's stow_skills fan-out instead --
# categories flattened, each skill linked as a folder (what Codex requires).
^/\.agents/skills$
