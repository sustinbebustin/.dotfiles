{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-6",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "256000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Edit",
      "MultiEdit",
      "Write",
      "Skill(commit)",
      "Skill(create-agent-skills)",
      "Skill(doc-generator)",
      "Skill(frontend-design)",
      "Skill(git-worktree)",
      "Skill(index-knowledge)",
      "Skill(react-best-practices)",
      "Skill(prompt:*)",
      "WebSearch",
      "WebFetch",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(go:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(supabase db diff:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash($HOME/.claude/hooks/*)",
      "Bash(~/.claude/hooks/*)",
      "Bash($HOME/.claude/scripts/*)",
      "Bash(~/.claude/scripts/*)",
      "Bash(bash:$HOME/.claude/scripts/* *)",
      "Bash(bash:~/.claude/scripts/* *)",
      "Bash(bash ~/.claude/scripts/generate-reasoning.sh:*)",
      "Bash(cat:$HOME/.claude/*)",
      "Bash(cat:~/.claude/*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(tee:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)",
      "Bash(source:*)",
      "Bash(export:*)",
      "Bash(env:*)",
      "Bash(set:*)",
      "Bash(uv run:*)",
      "Bash(continuity:*)",
      "Bash(mcp-exec:*)",
      "Bash(mcp-generate:*)",
      "Bash(mcp-discover:*)",
      "Bash(rp-cli:*)",
      "Bash(sqlite3:*)",
      "Bash(pipx:*)",
      "Bash(uvx:*)",
      "Bash(pytest:*)",
      "Bash(qlty:*)",
      "Bash(rm -rf /tmp:*)",
      "mcp__firecrawl__*",
      "mcp__github__*",
      "mcp__perplexity__*",
      "mcp__nia__*",
      "mcp__morph__*",
      "mcp__ast-grep__*",
      "mcp__repoprompt__*",
      "mcp__git__*",
      "mcp__fetch__*",
      "mcp__qlty__*",
      "mcp__opensrc__*",
      "mcp__context7__*",
      "mcp__grep_app__*",
      "mcp__codesearch__*",
      "mcp__ide__getDiagnostics",
      "Read($HOME/.claude/**)",
      "Read(~/.claude/**)",
      "Glob($HOME/.claude/**)",
      "Glob(~/.claude/**)",
      "Skill(supabase)",
      "mcp__supabase__search_docs",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__generate_typescript_types",
      "mcp__context7__query-docs",
      "mcp__overseer__execute",
      "mcp__opensrc__execute",
      "mcp__context7__resolve-library-id",
      "mcp__grep_app__searchGitHub",
      "Skill(shadcn)"
    ],
    "deny": [
      "Bash(wget:*)",
      "Bash(rm -rf *)",
      "Bash(brew install:*)",
      "Read(**/.env)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.env)",
      "Read(**/secrets.enc)",
      "Read(**/*.key)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-env-files-bin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dangerous-git-bin"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-root-bin"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
